 <div data-kid=\"114\">\n          <h2 class=\"text-4xl font-space font-bold tracking-tight\" data-kid=\"115\">Today's Feed</h2>\n          <p class=\"text-zinc-500 mt-2 text-lg font-medium\" data-kid=\"116\">Freshly curated healthy inspirations</p>\n        </div>\n        <div class=\"flex items-center gap-2 p-1.5 bg-white border border-zinc-200 rounded-2xl shadow-sm\" data-kid=\"117\">\n          <button class=\"px-5 py-2 bg-zinc-900 text-white rounded-xl text-sm font-bold tracking-tight transition-all\" data-kid=\"118\">All</button>\n          <button class=\"px-5 py-2 text-zinc-500 hover:text-zinc-900 rounded-xl text-sm font-bold tracking-tight transition-all\" data-kid=\"119\">Trending</button>\n          <button class=\"px-5 py-2 text-zinc-500 hover:text-zinc-900 rounded-xl text-sm font-bold tracking-tight transition-all\" data-kid=\"120\">Easy</button>\n        </div>\n      </div>\n\n      <div class=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8\" data-kid=\"121\">\n        \n        \n        <div class=\"bg-white rounded-[40px] overflow-hidden shadow-sm border border-zinc-200 group bento-card hover:shadow-2xl hover:-translate-y-2 flex flex-col\" data-kid=\"122\">\n          <div class=\"relative aspect-square overflow-hidden\" data-kid=\"123\">\n            <img src=\"https://images.pexels.com/photos/6120506/pexels-photo-6120506.jpeg?auto=compress&cs=tinysrgb&w=600&q=80\" class=\"w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110\" alt=\"Lentil Soup\" decoding=\"async\" loading=\"lazy\" data-kid=\"124\">\n            \n            <div class=\"absolute -bottom-4 -right-2 w-16 h-16 bg-[#fbbf24] rounded-full border-4 border-white flex flex-col items-center justify-center sticker-shadow transform group-hover:rotate-12 group-hover:scale-110 transition-all duration-500 z-10\" data-kid=\"125\">\n              <span class=\"text-sm font-bold text-zinc-900 leading-none font-space tracking-tighter\" data-kid=\"126\">15</span>\n              <span class=\"text-[9px] font-bold text-zinc-900 uppercase tracking-tighter\" data-kid=\"127\">Min</span>\n            </div>\n            <button class=\"absolute top-5 right-5 p-3 bg-white/80 backdrop-blur-md rounded-[20px] text-zinc-900 hover:bg-white hover:scale-110 transition-all shadow-sm group/heart z-10\" data-kid=\"128\">\n              <i class=\"ti ti-heart-filled text-zinc-400 group-hover/heart:text-red-500 transition-colors\" data-kid=\"129\"></i>\n            </button>\n          </div>\n          <div class=\"p-7 pt-9 flex-grow flex flex-col\" data-kid=\"130\">\n            <h3 class=\"font-space font-bold text-lg text-zinc-900 mb-4 leading-snug group-hover:text-[#7D9D8A] transition-colors line-clamp-2\" data-kid=\"131\">Rustic Red Lentil & Spices Soup</h3>\n            <div class=\"mt-auto flex flex-wrap items-center gap-2\" data-kid=\"132\">\n              <span class=\"px-3 py-1 bg-zinc-50 text-zinc-500 text-[10px] font-bold rounded-full uppercase tracking-widest border border-zinc-100\" data-kid=\"133\">High Protein</span>\n              <div class=\"w-1 h-1 bg-zinc-300 rounded-full\" data-kid=\"134\"></div>\n              <span class=\"px-3 py-1 bg-zinc-50 text-zinc-500 text-[10px] font-bold rounded-full uppercase tracking-widest border border-zinc-100\" data-kid=\"135\">Low Carb</span>\n            </div>\n          </div>\n        </div>\n\n        \n        <div class=\"bg-white rounded-[40px] overflow-hidden shadow-sm border border-zinc-200 group bento-card hover:shadow-2xl hover:-translate-y-2\" data-kid=\"136\">\n          <div class=\"relative aspect-square\" data-kid=\"137\">\n            <img src=\"https://images.unsplash.com/photo-1666819604634-98dd67634148?auto=format&w=600&q=80&fit=crop\" class=\"w-full h-full object-cover transition-transform duration-700 group-hover:scale-110\" alt=\"Veggie Wrap\" decoding=\"async\" loading=\"lazy\" data-kid=\"138\">\n            <div class=\"absolute -bottom-5 -right-3 w-18 h-18 bg-[#fbbf24] rounded-full border-[6px] border-white flex flex-col items-center justify-center sticker-shadow transform group-hover:rotate-12 transition-transform z-10\" data-kid=\"139\">\n              <span class=\"text-sm font-bold text-zinc-900 leading-none font-space\" data-kid=\"140\">10</span>\n              <span class=\"text-[9px] font-bold text-zinc-900 uppercase tracking-tighter\" data-kid=\"141\">Min</span>\n            </div>\n            <button class=\"absolute top-5 right-5 p-3 bg-white/70 backdrop-blur-xl rounded-[20px] text-zinc-900 hover:bg-white transition-all shadow-sm\" data-kid=\"142\">\n              <i class=\"ti ti-heart-filled text-zinc-300 hover:text-red-500 transition-colors\" data-kid=\"143\"></i>\n            </button>\n          </div>\n          <div class=\"p-8 pt-10\" data-kid=\"144\">\n            <h3 class=\"font-space font-bold text-xl text-zinc-900 mb-4 leading-tight group-hover:text-[#7D9D8A] transition-colors\" data-kid=\"145\">Hummus & Fresh Veggie Wrap</h3>\n            <div class=\"flex items-center gap-3\" data-kid=\"146\">\n              <span class=\"px-3 py-1 bg-zinc-100 text-zinc-500 text-[10px] font-bold rounded-full uppercase tracking-widest border border-zinc-200\" data-kid=\"147\">Vegan</span>\n              <div class=\"w-1 h-1 bg-zinc-300 rounded-full\" data-kid=\"148\"></div>\n              <span class=\"px-3 py-1 bg-zinc-100 text-zinc-500 text-[10px] font-bold rounded-full uppercase tracking-widest border border-zinc-200\" data-kid=\"149\">Fast Food</span>\n            </div>\n          </div>\n        </div>\n\n        \n        <div class=\"bg-white rounded-[40px] overflow-hidden shadow-sm border border-zinc-200 group bento-card hover:shadow-2xl hover:-translate-y-2\" data-kid=\"150\">\n          <div class=\"relative aspect-square\" data-kid=\"151\">\n            <img src=\"https://images.pexels.com/photos/10267339/pexels-photo-10267339.jpeg?auto=compress&cs=tinysrgb&w=600&q=80\" class=\"w-full h-full object-cover transition-transform duration-700 group-hover:scale-110\" alt=\"Halloumi Salad\" decoding=\"async\" loading=\"lazy\" data-kid=\"152\">\n            <div class=\"absolute -bottom-5 -right-3 w-18 h-18 bg-[#fbbf24] rounded-full border-[6px] border-white flex flex-col items-center justify-center sticker-shadow transform group-hover:rotate-12 transition-transform z-10\" data-kid=\"153\">\n              <span class=\"text-sm font-bold text-zinc-900 leading-none font-space\" data-kid=\"154\">20</span>\n              <span class=\"text-[9px] font-bold text-zinc-900 uppercase tracking-tighter\" data-kid=\"155\">Min</span>\n            </div>\n            <button class=\"absolute top-5 right-5 p-3 bg-white/70 backdrop-blur-xl rounded-[20px] text-zinc-900 hover:bg-white transition-all shadow-sm\" data-kid=\"156\">\n              <i class=\"ti ti-heart-filled text-zinc-300 hover:text-red-500 transition-colors\" data-kid=\"157\"></i>\n            </button>\n          </div>\n          <div class=\"p-8 pt-10\" data-kid=\"158\">\n            <h3 class=\"font-space font-bold text-xl text-zinc-900 mb-4 leading-tight group-hover:text-[#7D9D8A] transition-colors\" data-kid=\"159\">Grilled Halloumi & Summer Salad</h3>\n            <div class=\"flex items-center gap-3\" data-kid=\"160\">\n              <span class=\"px-3 py-1 bg-zinc-100 text-zinc-500 text-[10px] font-bold rounded-full uppercase tracking-widest border border-zinc-200\" data-kid=\"161\">Keto</span>\n              <div class=\"w-1 h-1 bg-zinc-300 rounded-full\" data-kid=\"162\"></div>\n              <span class=\"px-3 py-1 bg-zinc-100 text-zinc-500 text-[10px] font-bold rounded-full uppercase tracking-widest border border-zinc-200\" data-kid=\"163\">Fresh</span>\n            </div>\n          </div>\n        </div>\n\n        \n        <div class=\"bg-white rounded-[40px] overflow-hidden shadow-sm border border-zinc-200 group bento-card hover:shadow-2xl hover:-translate-y-2\" data-kid=\"164\">\n          <div class=\"relative aspect-square\" data-kid=\"165\">\n            <img src=\"https://images.unsplash.com/photo-1673551490812-eaee2e9bf0ef?auto=format&w=600&q=80&fit=crop\" class=\"w-full h-full object-cover transition-transform duration-700 group-hover:scale-110\" alt=\"Lava Cake\" decoding=\"async\" loading=\"lazy\" data-kid=\"166\">\n            <div class=\"absolute -bottom-5 -right-3 w-18 h-18 bg-[#fbbf24] rounded-full border-[6px] border-white flex flex-col items-center justify-center sticker-shadow transform group-hover:rotate-12 transition-transform z-10\" data-kid=\"167\">\n              <span class=\"text-sm font-bold text-zinc-900 leading-none font-space\" data-kid=\"168\">25</span>\n              <span class=\"text-[9px] font-bold text-zinc-900 uppercase tracking-tighter\" data-kid=\"169\">Min</span>\n            </div>\n            <button class=\"absolute top-5 right-5 p-3 bg-white/70 backdrop-blur-xl rounded-[20px] text-zinc-900 hover:bg-white transition-all shadow-sm\" data-kid=\"170\">\n              <i class=\"ti ti-heart-filled text-zinc-300 hover:text-red-500 transition-colors\" data-kid=\"171\"></i>\n            </button>\n          </div>\n          <div class=\"p-8 pt-10\" data-kid=\"172\">\n            <h3 class=\"font-space font-bold text-xl text-zinc-900 mb-4 leading-tight group-hover:text-[#7D9D8A] transition-colors\" data-kid=\"173\">Molten Chocolate Lava Cake</h3>\n            <div class=\"flex items-center gap-3\" data-kid=\"174\">\n              <span class=\"px-3 py-1 bg-zinc-100 text-zinc-500 text-[10px] font-bold rounded-full uppercase tracking-widest border border-zinc-200\" data-kid=\"175\">Dessert</span>\n              <div class=\"w-1 h-1 bg-zinc-300 rounded-full\" data-kid=\"176\"></div>\n              <span class=\"px-3 py-1 bg-zinc-100 text-zinc-500 text-[10px] font-bold rounded-full uppercase tracking-widest border border-zinc-200\" data-kid=\"177\">Sweet</span>\n            </div>\n          </div>\n        </div>\n\n      </div>\n      \n      <div class=\"mt-16 flex justify-center\" data-kid=\"178\">\n        <button class=\"px-10 py-4 bg-white text-zinc-900 font-bold font-space rounded-full border border-zinc-200 hover:bg-zinc-50 hover:shadow-lg transition-all shadow-sm active:scale-95 tracking-widest uppercase text-sm\" data-kid=\"179\">Load More Recipes</button>\n      </div>\n    </section>\n\n  </main>\n\n  \n  <footer class=\"mt-32 border-t border-zinc-200 pt-20\" data-kid=\"180\">\n    <div class=\"max-w-7xl mx-auto px-6 grid grid-cols-1 md:grid-cols-4 gap-12\" data-kid=\"181\">\n      <div class=\"col-span-1 md:col-span-1\" data-kid=\"182\">\n        <div class=\"flex items-center gap-2 mb-6\" data-kid=\"183\">\n          <div class=\"w-10 h-10 bg-[#7D9D8A] rounded-xl flex items-center justify-center text-white\" data-kid=\"184\">\n            <i class=\"ti ti-chef-hat text-2xl\" data-kid=\"185\"></i>\n          </div>\n          <span class=\"font-space text-2xl font-bold tracking-tight\" data-kid=\"186\">Naya</span>\n        </div>\n        <p class=\"text-zinc-500 text-sm leading-relaxed mb-6\" data-kid=\"187\">Eat better, live better. Discover and share the best healthy recipes from around the globe.</p>\n        <div class=\"flex gap-4\" data-kid=\"188\">\n          <a href=\"#\" class=\"w-10 h-10 bg-white border border-zinc-200 rounded-full flex items-center justify-center text-zinc-400 hover:text-zinc-900 hover:border-zinc-900 transition-all\" data-kid=\"189\"><i class=\"ti ti-brand-instagram\" data-kid=\"190\"></i></a>\n          <a href=\"#\" class=\"w-10 h-10 bg-white border border-zinc-200 rounded-full flex items-center justify-center text-zinc-400 hover:text-zinc-900 hover:border-zinc-900 transition-all\" data-kid=\"191\"><i class=\"ti ti-brand-pinterest\" data-kid=\"192\"></i></a>\n          <a href=\"#\" class=\"w-10 h-10 bg-white border border-zinc-200 rounded-full flex items-center justify-center text-zinc-400 hover:text-zinc-900 hover:border-zinc-900 transition-all\" data-kid=\"193\"><i class=\"ti ti-brand-tiktok\" data-kid=\"194\"></i></a>\n        </div>\n      </div>\n      \n      <div data-kid=\"195\">\n        <h4 class=\"font-space font-bold text-sm uppercase tracking-widest mb-6 text-zinc-400\" data-kid=\"196\">Company</h4>\n        <ul class=\"space-y-4\" data-kid=\"197\">\n          <li data-kid=\"198\"><a href=\"#\" class=\"text-sm font-semibold text-zinc-600 hover:text-[#7D9D8A] transition-colors\" data-kid=\"199\">About Us</a></li>\n          <li data-kid=\"200\"><a href=\"#\" class=\"text-sm font-semibold text-zinc-600 hover:text-[#7D9D8A] transition-colors\" data-kid=\"201\">Careers</a></li>\n          <li data-kid=\"202\"><a href=\"#\" class=\"text-sm font-semibold text-zinc-600 hover:text-[#7D9D8A] transition-colors\" data-kid=\"203\">Contact</a></li>\n        </ul>\n      </div>\n\n      <div data-kid=\"204\">\n        <h4 class=\"font-space font-bold text-sm uppercase tracking-widest mb-6 text-zinc-400\" data-kid=\"205\">Recipes</h4>\n        <ul class=\"space-y-4\" data-kid=\"206\">\n          <li data-kid=\"207\"><a href=\"#\" class=\"text-sm font-semibold text-zinc-600 hover:text-[#7D9D8A] transition-colors\" data-kid=\"208\">Breakfast</a></li>\n          <li data-kid=\"209\"><a href=\"#\" class=\"text-sm font-semibold text-zinc-600 hover:text-[#7D9D8A] transition-colors\" data-kid=\"210\">Vegan Diets</a></li>\n          <li data-kid=\"211\"><a href=\"#\" class=\"text-sm font-semibold text-zinc-600 hover:text-[#7D9D8A] transition-colors\" data-kid=\"212\">Quick & Easy</a></li>\n        </ul>\n      </div>\n\n      <div class=\"bg-zinc-900 rounded-[32px] p-10 text-white relative overflow-hidden group\" data-kid=\"213\">\n        <div class=\"absolute top-0 right-0 w-32 h-32 bg-[#7D9D8A]/20 rounded-full -mr-10 -mt-10 blur-3xl transition-all group-hover:scale-150\" data-kid=\"214\"></div>\n        <h4 class=\"font-space font-bold text-xl mb-4 relative z-10\" data-kid=\"215\">Fresh recipes in your inbox</h4>\n        <div class=\"relative z-10\" data-kid=\"216\">\n          <input type=\"email\" placeholder=\"Email address\" class=\"w-full bg-white/10 border border-white/20 rounded-2xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-[#7D9D8A] mb-4 transition-all\" data-kid=\"217\">\n          <button class=\"w-full bg-[#7D9D8A] text-white font-bold font-space py-4 rounded-3xl hover:bg-[#6a8473] transition-all active:scale-95 shadow-lg shadow-[#7D9D8A]/30\" data-kid=\"218\">Subscribe</button>\n        </div>\n      </div>\n    </div>\n    <div class=\"max-w-7xl mx-auto px-6 mt-20 py-8 border-t border-zinc-200 flex flex-col md:flex-row justify-between items-center gap-4\" data-kid=\"219\">\n      <p class=\"text-xs font-bold text-zinc-400 uppercase tracking-widest\" data-kid=\"220\">© 2024 Naya Kitchen. All Rights Reserved.</p>\n      <div class=\"flex gap-8\" data-kid=\"221\">\n        <a href=\"#\" class=\"text-xs font-bold text-zinc-400 uppercase tracking-widest hover:text-zinc-900 transition-colors\" data-kid=\"222\">Privacy Policy</a>\n        <a href=\"#\" class=\"text-xs font-bold text-zinc-400 uppercase tracking-widest hover:text-zinc-900 transition-colors\" data-kid=\"223\">Terms of Use</a>\n      </div>\n    </div>\n  </footer>\n</div>\n",
