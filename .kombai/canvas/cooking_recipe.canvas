    "var_7c07ae06e2a4": {
      "type": "variant",
      "label": "Page: À Propos",
      "parentId": "var_f90fbbb6292e",
      "themeId": null,
      "rect": {
        "x": 14320,
        "y": 0,
        "w": 1440,
        "h": 3075
      },
      "generation": {
        "prompt": "",
        "config": {}
      },
      "html": "\n<div class=\"bg-[#FAFAFA] text-zinc-900 font-sans min-h-[1400px] relative overflow-hidden\" data-kid=\"0\">\n  \n  <div class=\"absolute inset-0 opacity-[0.03] pointer-events-none\" style=\"background-image: url('https://www.transparenttextures.com/patterns/paper-fibers.png');\" data-kid=\"1\"></div>\n\n  \n  <div class=\"h-2 bg-zinc-900 w-full\" data-kid=\"2\"></div>\n\n  <main class=\"max-w-7xl mx-auto px-6 lg:px-12 py-24 relative\" data-kid=\"3\">\n    \n    \n    <header class=\"mb-32\" data-kid=\"4\">\n      <div class=\"flex flex-col md:flex-row md:items-end justify-between gap-8 border-b-2 border-zinc-900 pb-12\" data-kid=\"5\">\n        <div class=\"max-w-2xl\" data-kid=\"6\">\n          <span class=\"text-xs font-bold uppercase tracking-[0.3em] text-emerald-700 mb-6 block\" data-kid=\"7\">À Propos de Naya</span>\n          <h1 class=\"text-6xl md:text-8xl font-serif leading-[0.85] tracking-tighter text-zinc-900\" data-kid=\"8\">\n            L'Art de Bien <br data-kid=\"9\"> <span class=\"italic text-emerald-800\" data-kid=\"10\">Cuisiner</span> au Quotidien.\n          </h1>\n        </div>\n        <div class=\"md:text-right\" data-kid=\"11\">\n          <p class=\"text-zinc-500 font-medium max-w-xs leading-relaxed\" data-kid=\"12\">\n            Une plateforme dédiée à la redécouverte des produits frais, de la saisonnalité et du plaisir de partager un repas.\n          </p>\n        </div>\n      </div>\n    </header>\n\n    \n    <section class=\"grid grid-cols-12 gap-12 lg:gap-24 items-start mb-40\" data-kid=\"13\">\n      \n      \n      <aside class=\"col-span-12 lg:col-span-4 lg:sticky lg:top-24 mb-16 lg:mb-0\" data-kid=\"14\">\n        <div class=\"space-y-12 lg:pr-8\" data-kid=\"15\">\n          <div class=\"relative\" data-kid=\"16\">\n            <h2 class=\"text-8xl xl:text-[9rem] font-serif italic leading-[0.75] tracking-tighter text-zinc-900\" data-kid=\"17\">\n              Notre <br data-kid=\"18\"> Philosophie\n            </h2>\n            <div class=\"absolute -top-12 -left-8 opacity-20 hidden xl:block\" data-kid=\"19\">\n              <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/lorc/leaf-swirl.svg\" class=\"w-32 h-32\" style=\"filter: brightness(0) saturate(100%) invert(0%);\" data-kid=\"20\">\n            </div>\n          </div>\n          <div class=\"h-2 w-32 bg-zinc-900\" data-kid=\"21\"></div>\n          <div class=\"space-y-8\" data-kid=\"22\">\n            <p class=\"text-xl text-zinc-600 leading-relaxed italic border-l-4 border-emerald-100 pl-6\" data-kid=\"23\">\n              \"La cuisine n'est pas une corvée, c'est un langage universel de soin, de partage et de pure créativité.\"\n            </p>\n            <div class=\"rounded-[2.5rem] overflow-hidden aspect-[3/4] shadow-2xl rotate-[-3deg] transition-all hover:rotate-0 hover:scale-[1.02] duration-700 bg-zinc-200\" data-kid=\"24\">\n              <img src=\"https://images.unsplash.com/photo-1734113542343-fc916b32ef17?auto=format&w=800&q=80&fit=crop\" alt=\"Main Philosophy\" class=\"w-full h-full object-cover\" decoding=\"async\" loading=\"lazy\" data-kid=\"25\">\n            </div>\n          </div>\n        </div>\n      </aside>\n\n      \n      <div class=\"col-span-12 lg:col-span-8\" data-kid=\"26\">\n        <div class=\"border-t-[12px] border-zinc-900 pt-16 space-y-24\" data-kid=\"27\">\n          \n          \n          <div class=\"space-y-16\" data-kid=\"28\">\n            \n            <div class=\"group border-b border-zinc-200 pb-16 transition-all\" data-kid=\"29\">\n              <div class=\"flex items-start gap-12 cursor-pointer\" data-kid=\"30\">\n                <span class=\"text-xs font-bold font-sans text-emerald-800 tracking-widest pt-2\" data-kid=\"31\">01.</span>\n                <div class=\"flex-1 flex items-start justify-between gap-8\" data-kid=\"32\">\n                  <h3 class=\"text-3xl md:text-4xl font-serif text-zinc-900 leading-tight group-hover:text-emerald-900 transition-colors\" data-kid=\"33\">\n                    Comment créer une recette sur la plateforme ?\n                  </h3>\n                  <button class=\"shrink-0 w-12 h-12 rounded-full border border-zinc-200 flex items-center justify-center transition-all group-hover:bg-zinc-900 group-hover:text-white group-hover:border-zinc-900\" data-kid=\"34\">\n                    <i class=\"ti ti-plus text-xl font-light\" data-kid=\"35\"></i>\n                  </button>\n                </div>\n              </div>\n              <div class=\"mt-8 pl-16 text-xl text-zinc-500 leading-relaxed max-w-3xl\" data-kid=\"36\">\n                Pour créer une recette, connectez-vous à votre compte et cliquez sur le bouton \"+\" dans la barre de navigation, puis sélectionnez \"Créer une recette\". Notre éditeur intuitif vous guidera à travers chaque étape, du choix des ingrédients au temps de repos.\n              </div>\n            </div>\n\n            \n            <div class=\"group border-b border-zinc-200 pb-16 transition-all\" data-kid=\"37\">\n              <div class=\"flex items-start gap-12 cursor-pointer\" data-kid=\"38\">\n                <span class=\"text-xs font-bold font-sans text-emerald-800 tracking-widest pt-2\" data-kid=\"39\">02.</span>\n                <div class=\"flex-1 flex items-start justify-between gap-8\" data-kid=\"40\">\n                  <h3 class=\"text-3xl md:text-4xl font-serif text-zinc-900 leading-tight group-hover:text-emerald-900 transition-colors\" data-kid=\"41\">\n                    Comment ajouter une recette à mes favoris ?\n                  </h3>\n                  <button class=\"shrink-0 w-12 h-12 rounded-full border border-zinc-200 flex items-center justify-center transition-all group-hover:bg-zinc-900 group-hover:text-white group-hover:border-zinc-900\" data-kid=\"42\">\n                    <i class=\"ti ti-plus text-xl font-light\" data-kid=\"43\"></i>\n                  </button>\n                </div>\n              </div>\n              <div class=\"mt-8 pl-16 text-xl text-zinc-500 leading-relaxed max-w-3xl\" data-kid=\"44\">\n                Sur chaque fiche recette, vous trouverez un bouton coeur \"♥\" pour ajouter la recette à vos favoris. Vous pouvez retrouver toutes vos recettes favorites en un clic dans votre tableau de bord personnalisé, triées par date d'ajout.\n              </div>\n            </div>\n\n            \n            <div class=\"group border-b border-zinc-200 pb-16 transition-all\" data-kid=\"45\">\n              <div class=\"flex items-start gap-12 cursor-pointer\" data-kid=\"46\">\n                <span class=\"text-xs font-bold font-sans text-emerald-800 tracking-widest pt-2\" data-kid=\"47\">03.</span>\n                <div class=\"flex-1 flex items-start justify-between gap-8\" data-kid=\"48\">\n                  <h3 class=\"text-3xl md:text-4xl font-serif text-zinc-900 leading-tight group-hover:text-emerald-900 transition-colors\" data-kid=\"49\">\n                    Comment modifier mon profil utilisateur ?\n                  </h3>\n                  <button class=\"shrink-0 w-12 h-12 rounded-full border border-zinc-200 flex items-center justify-center transition-all group-hover:bg-zinc-900 group-hover:text-white group-hover:border-zinc-900\" data-kid=\"50\">\n                    <i class=\"ti ti-plus text-xl font-light\" data-kid=\"51\"></i>\n                  </button>\n                </div>\n              </div>\n              <div class=\"mt-8 pl-16 text-xl text-zinc-500 leading-relaxed max-w-3xl\" data-kid=\"52\">\n                Accédez à votre dashboard en cliquant sur \"Mon Dashboard\" dans le menu utilisateur. Vous pourrez y modifier vos informations personnelles, vos préférences alimentaires (vegan, sans gluten, etc.) et vos paramètres de notifications.\n              </div>\n            </div>\n\n            \n            <div class=\"group border-b border-zinc-200 pb-16 transition-all\" data-kid=\"53\">\n              <div class=\"flex items-start gap-12 cursor-pointer\" data-kid=\"54\">\n                <span class=\"text-xs font-bold font-sans text-emerald-800 tracking-widest pt-2\" data-kid=\"55\">04.</span>\n                <div class=\"flex-1 flex items-start justify-between gap-8\" data-kid=\"56\">\n                  <h3 class=\"text-3xl md:text-4xl font-serif text-zinc-900 leading-tight group-hover:text-emerald-900 transition-colors\" data-kid=\"57\">\n                    Besoin de plus d'aide ou d'un conseil ?\n                  </h3>\n                  <button class=\"shrink-0 w-12 h-12 rounded-full border border-zinc-200 flex items-center justify-center transition-all group-hover:bg-zinc-900 group-hover:text-white group-hover:border-zinc-900\" data-kid=\"58\">\n                    <i class=\"ti ti-plus text-xl font-light\" data-kid=\"59\"></i>\n                  </button>\n                </div>\n              </div>\n              <div class=\"mt-8 pl-16 text-xl text-zinc-500 leading-relaxed max-w-3xl\" data-kid=\"60\">\n                Si vous ne trouvez pas la réponse à votre question, n'hésitez pas à nous contacter directement. Notre équipe de passionnés est là pour vous accompagner dans votre voyage culinaire quotidien.\n                <div class=\"mt-6\" data-kid=\"61\">\n                  <a href=\"mailto:support@cookingrecipe.com\" class=\"inline-flex items-center gap-2 text-emerald-800 font-bold border-b-2 border-emerald-800 hover:text-emerald-950 hover:border-emerald-950 transition-colors\" data-kid=\"62\">\n                    support@cookingrecipe.com\n                    <i class=\"ti ti-arrow-right text-sm\" data-kid=\"63\"></i>\n                  </a>\n                </div>\n              </div>\n            </div>\n          </div>\n\n          \n          <div class=\"bg-emerald-50 rounded-[3rem] p-12 lg:p-20 relative overflow-hidden group\" data-kid=\"64\">\n            <div class=\"absolute top-0 right-0 p-8 opacity-10 rotate-12 transition-transform group-hover:rotate-0 duration-700\" data-kid=\"65\">\n              <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/lorc/leaf-swirl.svg\" class=\"w-64 h-64 text-emerald-900\" style=\"filter: brightness(0) saturate(100%) invert(13%) sepia(35%) saturate(5412%) hue-rotate(146deg) brightness(93%) contrast(101%);\" data-kid=\"66\">\n            </div>\n            <div class=\"relative z-10 max-w-lg\" data-kid=\"67\">\n              <h4 class=\"text-4xl font-serif italic text-emerald-900 mb-8 leading-tight\" data-kid=\"68\">Rejoignez une communauté qui célèbre le goût.</h4>\n              <p class=\"text-emerald-800/80 mb-10 leading-relaxed\" data-kid=\"69\">\n                Naya n'est pas seulement une application, c'est un mouvement vers une alimentation plus consciente et joyeuse. \n              </p>\n              <button class=\"px-10 py-5 bg-zinc-900 text-white rounded-full font-bold hover:bg-emerald-900 transition-colors shadow-xl\" data-kid=\"70\">\n                Explorer les recettes\n              </button>\n            </div>\n          </div>\n\n        </div>\n      </div>\n    </section>\n\n    \n    <footer class=\"border-t-[12px] border-zinc-900 pt-16 flex flex-col md:flex-row justify-between items-center gap-8 mb-16\" data-kid=\"71\">\n      <div class=\"text-xs font-bold uppercase tracking-[0.4em] text-zinc-400\" data-kid=\"72\">© 2024 Naya Culinary Editorial</div>\n      <div class=\"flex gap-12\" data-kid=\"73\">\n        <a href=\"#\" class=\"text-xs font-bold uppercase tracking-widest hover:text-emerald-700 transition-colors\" data-kid=\"74\">Instagram</a>\n        <a href=\"#\" class=\"text-xs font-bold uppercase tracking-widest hover:text-emerald-700 transition-colors\" data-kid=\"75\">Newsletter</a>\n        <a href=\"#\" class=\"text-xs font-bold uppercase tracking-widest hover:text-emerald-700 transition-colors\" data-kid=\"76\">Mentions Légales</a>\n      </div>\n    </footer>\n\n  </main>\n</div>\n\n<style data-kid=\"77\">\n  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Inter:wght@100..900&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  body {\n    background-color: #FAFAFA;\n    margin: 0;\n  }\n\n  .font-serif {\n    font-family: 'Playfair Display', serif;\n  }\n\n  .font-sans {\n    font-family: 'Inter', sans-serif;\n  }\n\n  /* Custom text selection color */\n  ::selection {\n    background: #065f46;\n    color: white;\n  }\n</style>\n",
