      "html": "\n<div class=\"bg-[#fafafa] font-['Inter'] text-[#18181b]\" data-kid=\"0\">\n    \n    <link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" data-kid=\"1\">\n    \n    <script src=\"https://cdn.jsdelivr.net/npm/chart.js\" data-kid=\"2\"></script>\n\n    <style data-kid=\"3\">\n        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap');\n        @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,900;1,700&display=swap');\n\n        .font-inter { font-family: 'Inter', sans-serif; }\n        .font-serif { font-family: 'Playfair Display', serif; }\n        \n        /* Custom scrollbar for a cleaner look */\n        ::-webkit-scrollbar { width: 8px; }\n        ::-webkit-scrollbar-track { background: #f4f4f5; }\n        ::-webkit-scrollbar-thumb { background: #d4d4d8; border-radius: 4px; }\n        ::-webkit-scrollbar-thumb:hover { background: #a1a1aa; }\n\n        .title-shadow {\n            text-shadow: 2px 2px 0px rgba(125, 157, 138, 0.1);\n        }\n\n        @keyframes pulse-custom {\n            0% { box-shadow: 0 0 0 0 rgba(125, 157, 138, 0.4); }\n            70% { box-shadow: 0 0 0 20px rgba(125, 157, 138, 0); }\n            100% { box-shadow: 0 0 0 0 rgba(125, 157, 138, 0); }\n        }\n\n        .animate-pulse-custom {\n            animation: pulse-custom 2s infinite;\n        }\n\n        .chart-container {\n            position: relative;\n            margin: auto;\n            height: 200px;\n            width: 200px;\n        }\n    </style>\n\n    \n    <header class=\"relative w-full h-[650px]\" data-kid=\"4\">\n        <img src=\"https://images.unsplash.com/photo-1609517467607-19c857f333ec?auto=format&w=1600&q=80&fit=crop\" alt=\"Overhead plated dish\" class=\"w-full h-full object-cover\" decoding=\"async\" loading=\"lazy\" data-kid=\"5\">\n        \n        <div class=\"absolute inset-0 bg-gradient-to-b from-black/20 via-transparent to-[#fafafa]\" data-kid=\"6\"></div>\n        \n        \n        <div class=\"absolute bottom-0 left-0 w-full\" data-kid=\"7\">\n            <div class=\"max-w-7xl mx-auto px-6 mb-[-120px] relative z-20\" data-kid=\"8\">\n                <div class=\"bg-white p-12 md:p-16 shadow-[0_32px_64px_-16px_rgba(0,0,0,0.1)] rounded-sm border-t-8 border-[#7D9D8A]\" data-kid=\"9\">\n                    <div class=\"flex flex-wrap gap-3 mb-8\" data-kid=\"10\">\n                        <span class=\"px-5 py-2 bg-[#eaf1ec] text-[#576b5d] text-[10px] font-black tracking-[0.2em] uppercase rounded-full\" data-kid=\"11\">Gluten-Free</span>\n                        <span class=\"px-5 py-2 bg-[#eaf1ec] text-[#576b5d] text-[10px] font-black tracking-[0.2em] uppercase rounded-full\" data-kid=\"12\">High Protein</span>\n                        <span class=\"px-5 py-2 bg-[#eaf1ec] text-[#576b5d] text-[10px] font-black tracking-[0.2em] uppercase rounded-full\" data-kid=\"13\">Dairy Free</span>\n                    </div>\n                    <div class=\"flex flex-col lg:flex-row lg:items-end lg:justify-between gap-10\" data-kid=\"14\">\n                        <div class=\"max-w-3xl\" data-kid=\"15\">\n                            <h1 class=\"text-5xl md:text-7xl font-black text-[#18181b] tracking-tighter leading-[1] uppercase mb-6 title-shadow font-serif italic\" data-kid=\"16\">\n                                Braised Harissa <br data-kid=\"17\"> Lamb Shoulder\n                            </h1>\n                            <div class=\"flex gap-12 border-t border-[#e4e4e7] pt-8\" data-kid=\"18\">\n                                <div class=\"flex flex-col\" data-kid=\"19\">\n                                    <span class=\"text-[10px] uppercase tracking-[0.25em] text-[#a1a1aa] font-bold mb-2\" data-kid=\"20\">Prep</span>\n                                    <span class=\"text-2xl font-black text-[#18181b]\" data-kid=\"21\">25<span class=\"text-sm ml-1 text-[#71717a]\" data-kid=\"22\">min</span></span>\n                                </div>\n                                <div class=\"flex flex-col\" data-kid=\"23\">\n                                    <span class=\"text-[10px] uppercase tracking-[0.25em] text-[#a1a1aa] font-bold mb-2\" data-kid=\"24\">Cook</span>\n                                    <span class=\"text-2xl font-black text-[#18181b]\" data-kid=\"25\">4.5<span class=\"text-sm ml-1 text-[#71717a]\" data-kid=\"26\">hrs</span></span>\n                                </div>\n                                <div class=\"flex flex-col\" data-kid=\"27\">\n                                    <span class=\"text-[10px] uppercase tracking-[0.25em] text-[#a1a1aa] font-bold mb-2\" data-kid=\"28\">Effort</span>\n                                    <span class=\"text-2xl font-black text-[#18181b]\" data-kid=\"29\">Mid</span>\n                                </div>\n                            </div>\n                        </div>\n                        <button class=\"bg-[#7D9D8A] hover:bg-[#6a8473] text-white px-12 py-6 rounded-full font-black tracking-[0.15em] uppercase transition-all shadow-xl hover:shadow-[#7D9D8A]/30 flex items-center gap-4 group animate-pulse-custom\" data-kid=\"30\">\n                            Start Cooking\n                            <i class=\"ti ti-chevron-right text-xl group-hover:translate-x-1 transition-transform\" data-kid=\"31\"></i>\n                        </button>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </header>\n\n    \n    <div class=\"h-[150px]\" data-kid=\"32\"></div>\n\n    \n    <main class=\"max-w-7xl mx-auto px-6 pb-32\" data-kid=\"33\">\n        <div class=\"flex flex-col lg:flex-row gap-20\" data-kid=\"34\">\n            \n            \n            <section class=\"lg:w-[62%]\" data-kid=\"35\">\n                <div class=\"flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6 pb-8 border-b-2 border-[#18181b]\" data-kid=\"36\">\n                    <div data-kid=\"37\">\n                        <h2 class=\"text-4xl font-black uppercase tracking-tight text-[#18181b] mb-2\" data-kid=\"38\">Ingredients</h2>\n                        <p class=\"text-[#71717a] font-medium tracking-wide\" data-kid=\"39\">Adjust quantities based on your table size.</p>\n                    </div>\n                    \n                    <div class=\"flex items-center gap-6 bg-white p-2.5 rounded-full shadow-[0_4px_20px_rgba(0,0,0,0.04)] border border-[#e4e4e7]\" data-kid=\"40\">\n                        <span class=\"text-[9px] font-black uppercase tracking-[0.25em] text-[#a1a1aa] pl-5\" data-kid=\"41\">Servings</span>\n                        <div class=\"flex items-center gap-2\" data-kid=\"42\">\n                            <button class=\"w-11 h-11 flex items-center justify-center rounded-full bg-[#fef3c7] text-[#b45309] hover:bg-[#fde68a] hover:scale-105 transition-all transform active:scale-90 border-2 border-white shadow-sm\" data-kid=\"43\">\n                                <i class=\"ti ti-minus text-lg\" data-kid=\"44\"></i>\n                            </button>\n                            <div class=\"bg-[#fafafa] px-5 py-2 rounded-full border border-[#e4e4e7]\" data-kid=\"45\">\n                                <span class=\"text-xl font-black tabular-nums\" id=\"serving-count\" data-kid=\"46\">04</span>\n                            </div>\n                            <button class=\"w-11 h-11 flex items-center justify-center rounded-full bg-[#fef3c7] text-[#b45309] hover:bg-[#fde68a] hover:scale-105 transition-all transform active:scale-90 border-2 border-white shadow-sm\" data-kid=\"47\">\n                                <i class=\"ti ti-plus text-lg\" data-kid=\"48\"></i>\n                            </button>\n                        </div>\n                    </div>\n                </div>\n\n                <div class=\"space-y-1\" data-kid=\"49\">\n                    \n                    <div class=\"group flex items-center justify-between py-6 px-6 -mx-6 hover:bg-white hover:shadow-sm border-b border-[#e4e4e7] transition-all cursor-default\" data-kid=\"50\">\n                        <div class=\"flex items-center gap-4\" data-kid=\"51\">\n                            <div class=\"w-2 h-2 rounded-full bg-transparent group-hover:bg-[#7D9D8A] transition-colors\" data-kid=\"52\"></div>\n                            <span class=\"text-xl text-[#3f3f46] group-hover:text-[#18181b] font-medium transition-colors\" data-kid=\"53\">Bone-in lamb shoulder, grass-fed</span>\n                        </div>\n                        <span class=\"text-2xl font-black text-[#18181b] group-hover:text-[#7D9D8A] transition-colors tabular-nums\" data-kid=\"54\">2.4 <span class=\"text-xs uppercase text-[#a1a1aa] font-bold\" data-kid=\"55\">kg</span></span>\n                    </div>\n                    \n                    <div class=\"group flex items-center justify-between py-6 px-6 -mx-6 hover:bg-white hover:shadow-sm border-b border-[#e4e4e7] transition-all cursor-default\" data-kid=\"56\">\n                        <div class=\"flex items-center gap-4\" data-kid=\"57\">\n                            <div class=\"w-2 h-2 rounded-full bg-transparent group-hover:bg-[#7D9D8A] transition-colors\" data-kid=\"58\"></div>\n                            <span class=\"text-xl text-[#3f3f46] group-hover:text-[#18181b] font-medium transition-colors\" data-kid=\"59\">Rose Harissa paste (homemade)</span>\n                        </div>\n                        <span class=\"text-2xl font-black text-[#18181b] group-hover:text-[#7D9D8A] transition-colors tabular-nums\" data-kid=\"60\">180 <span class=\"text-xs uppercase text-[#a1a1aa] font-bold\" data-kid=\"61\">g</span></span>\n                    </div>\n\n                    <div class=\"group flex items-center justify-between py-6 px-6 -mx-6 hover:bg-white hover:shadow-sm border-b border-[#e4e4e7] transition-all cursor-default\" data-kid=\"62\">\n                        <div class=\"flex items-center gap-4\" data-kid=\"63\">\n                            <div class=\"w-2 h-2 rounded-full bg-transparent group-hover:bg-[#7D9D8A] transition-colors\" data-kid=\"64\"></div>\n                            <span class=\"text-xl text-[#3f3f46] group-hover:text-[#18181b] font-medium transition-colors\" data-kid=\"65\">Medjool dates, pitted</span>\n                        </div>\n                        <span class=\"text-2xl font-black text-[#18181b] group-hover:text-[#7D9D8A] transition-colors tabular-nums\" data-kid=\"66\">12 <span class=\"text-xs uppercase text-[#a1a1aa] font-bold\" data-kid=\"67\">pcs</span></span>\n                    </div>\n\n                    <div class=\"group flex items-center justify-between py-6 px-6 -mx-6 hover:bg-white hover:shadow-sm border-b border-[#e4e4e7] transition-all cursor-default\" data-kid=\"68\">\n                        <div class=\"flex items-center gap-4\" data-kid=\"69\">\n                            <div class=\"w-2 h-2 rounded-full bg-transparent group-hover:bg-[#7D9D8A] transition-colors\" data-kid=\"70\"></div>\n                            <span class=\"text-xl text-[#3f3f46] group-hover:text-[#18181b] font-medium transition-colors\" data-kid=\"71\">Toasted cumin seeds, roughly ground</span>\n                        </div>\n                        <span class=\"text-2xl font-black text-[#18181b] group-hover:text-[#7D9D8A] transition-colors tabular-nums\" data-kid=\"72\">1 <span class=\"text-xs uppercase text-[#a1a1aa] font-bold\" data-kid=\"73\">tbsp</span></span>\n                    </div>\n\n                    <div class=\"group flex items-center justify-between py-6 px-6 -mx-6 hover:bg-white hover:shadow-sm border-b border-[#e4e4e7] transition-all cursor-default\" data-kid=\"74\">\n                        <div class=\"flex items-center gap-4\" data-kid=\"75\">\n                            <div class=\"w-2 h-2 rounded-full bg-transparent group-hover:bg-[#7D9D8A] transition-colors\" data-kid=\"76\"></div>\n                            <span class=\"text-xl text-[#3f3f46] group-hover:text-[#18181b] font-medium transition-colors\" data-kid=\"77\">Preserved lemon rind, julienned</span>\n                        </div>\n                        <span class=\"text-2xl font-black text-[#18181b] group-hover:text-[#7D9D8A] transition-colors tabular-nums\" data-kid=\"78\">2 <span class=\"text-xs uppercase text-[#a1a1aa] font-bold\" data-kid=\"79\">tbsp</span></span>\n                    </div>\n\n                    <div class=\"group flex items-center justify-between py-6 px-6 -mx-6 hover:bg-white hover:shadow-sm border-b border-[#e4e4e7] transition-all cursor-default\" data-kid=\"80\">\n                        <div class=\"flex items-center gap-4\" data-kid=\"81\">\n                            <div class=\"w-2 h-2 rounded-full bg-transparent group-hover:bg-[#7D9D8A] transition-colors\" data-kid=\"82\"></div>\n                            <span class=\"text-xl text-[#3f3f46] group-hover:text-[#18181b] font-medium transition-colors\" data-kid=\"83\">Greek yogurt for serving</span>\n                        </div>\n                        <span class=\"text-2xl font-black text-[#18181b] group-hover:text-[#7D9D8A] transition-colors tabular-nums\" data-kid=\"84\">250 <span class=\"text-xs uppercase text-[#a1a1aa] font-bold\" data-kid=\"85\">ml</span></span>\n                    </div>\n                    \n                    <div class=\"group flex items-center justify-between py-6 px-6 -mx-6 hover:bg-white hover:shadow-sm border-b border-[#e4e4e7] transition-all cursor-default\" data-kid=\"86\">\n                        <div class=\"flex items-center gap-4\" data-kid=\"87\">\n                            <div class=\"w-2 h-2 rounded-full bg-transparent group-hover:bg-[#7D9D8A] transition-colors\" data-kid=\"88\"></div>\n                            <span class=\"text-xl text-[#3f3f46] group-hover:text-[#18181b] font-medium transition-colors\" data-kid=\"89\">Fresh cilantro and mint leaves</span>\n                        </div>\n                        <span class=\"text-2xl font-black text-[#18181b] group-hover:text-[#7D9D8A] transition-colors tabular-nums\" data-kid=\"90\">1 <span class=\"text-xs uppercase text-[#a1a1aa] font-bold\" data-kid=\"91\">handful</span></span>\n                    </div>\n                </div>\n            </section>\n\n            \n            <aside class=\"lg:w-[38%] space-y-12\" data-kid=\"92\">\n                \n                \n                <div class=\"bg-white p-12 rounded-sm shadow-[0_8px_32px_rgba(0,0,0,0.03)] border border-[#e4e4e7]\" data-kid=\"93\">\n                    <div class=\"text-center mb-10\" data-kid=\"94\">\n                        <h3 class=\"text-[10px] font-black uppercase tracking-[0.3em] text-[#a1a1aa] mb-2\" data-kid=\"95\">Macro Profile</h3>\n                        <p class=\"text-xs font-bold text-[#71717a]\" data-kid=\"96\">Nutritional values per serving</p>\n                    </div>\n                    \n                    <div class=\"chart-container mb-12\" data-kid=\"97\">\n                        <canvas id=\"macroChart\" data-kid=\"98\"></canvas>\n                        <div class=\"absolute inset-0 flex flex-col items-center justify-center pointer-events-none pt-2\" data-kid=\"99\">\n                            <span class=\"text-5xl font-black text-[#18181b]\" data-kid=\"100\">684</span>\n                            <span class=\"text-[9px] font-black uppercase tracking-widest text-[#a1a1aa]\" data-kid=\"101\">Calories</span>\n                        </div>\n                    </div>\n\n                    <div class=\"grid grid-cols-3 gap-6\" data-kid=\"102\">\n                        <div class=\"text-center\" data-kid=\"103\">\n                            <span class=\"block text-2xl font-black text-[#18181b]\" data-kid=\"104\">48g</span>\n                            <span class=\"text-[9px] font-black uppercase tracking-[0.2em] text-[#7D9D8A]\" data-kid=\"105\">Protein</span>\n                        </div>\n                        <div class=\"text-center\" data-kid=\"106\">\n                            <span class=\"block text-2xl font-black text-[#18181b]\" data-kid=\"107\">42g</span>\n                            <span class=\"text-[9px] font-black uppercase tracking-[0.2em] text-[#f59e0b]\" data-kid=\"108\">Healthy Fats</span>\n                        </div>\n                        <div class=\"text-center\" data-kid=\"109\">\n                            <span class=\"block text-2xl font-black text-[#18181b]\" data-kid=\"110\">14g</span>\n                            <span class=\"text-[9px] font-black uppercase tracking-[0.2em] text-[#71717a]\" data-kid=\"111\">Net Carbs</span>\n                        </div>\n                    </div>\n                </div>\n\n                \n                <div class=\"bg-[#eaf1ec] p-12 rounded-sm border-l-[12px] border-[#7D9D8A] relative overflow-hidden group\" data-kid=\"112\">\n                    <i class=\"ti ti-quote absolute -right-6 -top-6 text-[120px] text-[#7D9D8A]/10 transition-transform group-hover:rotate-12 duration-500\" data-kid=\"113\"></i>\n                    \n                    <div class=\"relative z-10\" data-kid=\"114\">\n                        <div class=\"flex items-center gap-4 mb-8\" data-kid=\"115\">\n                            <div class=\"w-10 h-10 bg-[#7D9D8A] rounded-full flex items-center justify-center text-white shadow-md\" data-kid=\"116\">\n                                <i class=\"ti ti-quote text-xl\" data-kid=\"117\"></i>\n                            </div>\n                            <h4 class=\"text-xs font-black uppercase tracking-[0.2em] text-[#576b5d]\" data-kid=\"118\">Chef's Studio Secret</h4>\n                        </div>\n                        \n                        <p class=\"text-[#313a31] text-2xl leading-relaxed font-serif italic font-semibold mb-10 tracking-tight\" data-kid=\"119\">\n                            \"The secret to that fork-tender texture isn't just time—it's the moisture seal. Ensure your roasting tray is tightly wrapped with two layers of foil to create a steam oven within your oven. This allows the collagen to melt into silk without drying out the fibers.\"\n                        </p>\n                        \n                        <div class=\"flex items-center gap-5 pt-8 border-t border-[#7D9D8A]/20\" data-kid=\"120\">\n                            <img src=\"https://i.pravatar.cc/120?u=chef_marcus\" class=\"w-16 h-16 rounded-full border-4 border-white shadow-lg grayscale hover:grayscale-0 transition-all cursor-pointer\" alt=\"Chef Marcus Thorne\" data-kid=\"121\">\n                            <div data-kid=\"122\">\n                                <span class=\"block text-lg font-black text-[#18181b] tracking-tight\" data-kid=\"123\">Marcus Thorne</span>\n                                <span class=\"text-xs font-bold text-[#576b5d] uppercase tracking-widest\" data-kid=\"124\">Executive Culinary Director</span>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n\n                \n                <div class=\"bg-[#18181b] p-10 rounded-sm shadow-2xl relative overflow-hidden group\" data-kid=\"125\">\n                    <div class=\"absolute inset-0 bg-gradient-to-br from-[#7D9D8A]/30 to-transparent\" data-kid=\"126\"></div>\n                    \n                    <div class=\"absolute top-10 right-10 w-2 h-2 bg-amber-500 rounded-full animate-ping\" data-kid=\"127\"></div>\n                    \n                    <div class=\"relative z-10 flex flex-col items-center text-center\" data-kid=\"128\">\n                        <div class=\"w-16 h-16 bg-white/5 rounded-full flex items-center justify-center mb-6 border border-white/10\" data-kid=\"129\">\n                            <i class=\"ti ti-microphone text-3xl text-[#f59e0b]\" data-kid=\"130\"></i>\n                        </div>\n                        <h4 class=\"text-white text-xl font-black uppercase tracking-tight mb-2\" data-kid=\"131\">Immersive Studio</h4>\n                        <p class=\"text-zinc-400 text-sm mb-8 leading-relaxed\" data-kid=\"132\">Activate voice-controlled step-by-step guidance for a hands-free kitchen experience.</p>\n                        <button class=\"w-full bg-emerald-500 hover:bg-emerald-600 text-white font-black py-5 px-8 rounded-full transition-all uppercase tracking-[0.15em] text-[10px] flex items-center justify-center gap-3 shadow-lg hover:shadow-emerald-500/20\" data-kid=\"133\">\n                            Start Cooking Session\n                            <i class=\"ti ti-external-link text-sm\" data-kid=\"134\"></i>\n                        </button>\n                    </div>\n                </div>\n            </aside>\n        </div>\n    </main>\n\n    <footer class=\"bg-white border-t border-[#e4e4e7] py-20\" data-kid=\"135\">\n        <div class=\"max-w-7xl mx-auto px-6 flex flex-col md:flex-row justify-between items-center gap-10\" data-kid=\"136\">\n            <div class=\"flex items-center gap-4\" data-kid=\"137\">\n                <div class=\"w-10 h-10 bg-[#18181b] rounded-sm flex items-center justify-center text-white font-black text-xl\" data-kid=\"138\">CS</div>\n                <span class=\"text-xl font-black uppercase tracking-tighter\" data-kid=\"139\">Culinary Studio</span>\n            </div>\n            <div class=\"flex gap-10 text-[10px] font-black uppercase tracking-[0.2em] text-[#71717a]\" data-kid=\"140\">\n                <a href=\"#\" class=\"hover:text-[#7D9D8A] transition-colors\" data-kid=\"141\">About Us</a>\n                <a href=\"#\" class=\"hover:text-[#7D9D8A] transition-colors\" data-kid=\"142\">Our Chefs</a>\n                <a href=\"#\" class=\"hover:text-[#7D9D8A] transition-colors\" data-kid=\"143\">Privacy Policy</a>\n            </div>\n            <div class=\"flex gap-6\" data-kid=\"144\">\n                <i class=\"ti ti-brand-instagram text-2xl text-[#18181b] hover:text-[#7D9D8A] cursor-pointer transition-colors\" data-kid=\"145\"></i>\n                <i class=\"ti ti-brand-pinterest text-2xl text-[#18181b] hover:text-[#7D9D8A] cursor-pointer transition-colors\" data-kid=\"146\"></i>\n                <i class=\"ti ti-brand-youtube text-2xl text-[#18181b] hover:text-[#7D9D8A] cursor-pointer transition-colors\" data-kid=\"147\"></i>\n            </div>\n        </div>\n        <div class=\"max-w-7xl mx-auto px-6 mt-12 text-center\" data-kid=\"148\">\n            <p class=\"text-[10px] font-bold text-[#a1a1aa] uppercase tracking-widest\" data-kid=\"149\">&copy; 2024 Modern Culinary Studio. All Rights Reserved.</p>\n        </div>\n    </footer>\n\n    <script data-kid=\"150\">\n        document.addEventListener('DOMContentLoaded', function() {\n            const ctx = document.getElementById('macroChart').getContext('2d');\n            new Chart(ctx, {\n                type: 'doughnut',\n                data: {\n                    labels: ['Protein', 'Fats', 'Carbs'],\n                    datasets: [{\n                        data: [48, 42, 10],\n                        backgroundColor: [\n                            '#7D9D8A', // Emerald 500\n                            '#f59e0b', // Amber 500\n                            '#e4e4e7'  // Zinc 200\n                        ],\n                        borderWidth: 0,\n                        hoverOffset: 4,\n                        cutout: '82%'\n                    }]\n                },\n                options: {\n                    responsive: true,\n                    maintainAspectRatio: false,\n                    plugins: {\n                        legend: {\n                            display: false\n                        },\n                        tooltip: {\n                            enabled: false\n                        }\n                    },\n                    animation: {\n                        animateRotate: true,\n                        duration: 2000,\n                        easing: 'easeOutQuart'\n                    }\n                }\n            });\n        });\n    </script>\n</div>\n",
