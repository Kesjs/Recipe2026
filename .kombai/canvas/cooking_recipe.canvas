        "h": 0
      },
      "html": "<div class=\"flex items-center justify-between w-full max-w-[800px] mx-auto px-8 py-6 font-sans bg-transparent\" data-kid=\"0\">\n  <style data-kid=\"1\">\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');\n    @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n    .font-sans {\n      font-family: 'Inter', sans-serif;\n    }\n  </style>\n\n  \n  <a href=\"/\" class=\"flex items-center space-x-3 group cursor-pointer transition-all duration-300 shrink-0\" data-kid=\"2\">\n    <div class=\"w-11 h-11 bg-emerald-600 rounded-xl flex items-center justify-center text-white shadow-xl shadow-emerald-600/10 group-hover:rotate-6 transition-transform duration-500\" data-kid=\"3\">\n      <i class=\"ti ti-leaf text-2xl\" data-kid=\"4\"></i>\n    </div>\n    <span class=\"font-bold text-2xl tracking-tighter text-emerald-900\" data-kid=\"5\">Naya</span>\n  </a>\n\n  \n  <nav class=\"flex items-center space-x-10\" data-kid=\"6\">\n    <a href=\"#\" class=\"relative text-sm font-bold tracking-tight text-emerald-900 pb-1 transition-all duration-300 group/link\" data-kid=\"7\">\n      Recettes\n      <span class=\"absolute -bottom-1 left-0 w-full h-[2.5px] bg-emerald-600 rounded-full\" data-kid=\"8\"></span>\n    </a>\n    <a href=\"#\" class=\"relative text-sm font-semibold tracking-tight text-zinc-500 hover:text-emerald-900 transition-colors duration-300 pb-1 group/link\" data-kid=\"9\">\n      Nutrition\n      <span class=\"absolute -bottom-1 left-0 w-0 h-[2px] bg-emerald-600/20 group-hover/link:w-full transition-all duration-300\" data-kid=\"10\"></span>\n    </a>\n    <a href=\"#\" class=\"relative text-sm font-semibold tracking-tight text-zinc-500 hover:text-emerald-900 transition-colors duration-300 pb-1 group/link\" data-kid=\"11\">\n      Actualités\n      <span class=\"absolute -bottom-1 left-0 w-0 h-[2px] bg-emerald-600/20 group-hover/link:w-full transition-all duration-300\" data-kid=\"12\"></span>\n    </a>\n    <a href=\"#\" class=\"relative text-sm font-semibold tracking-tight text-zinc-500 hover:text-emerald-900 transition-colors duration-300 pb-1 group/link\" data-kid=\"13\">\n      À Propos\n      <span class=\"absolute -bottom-1 left-0 w-0 h-[2px] bg-emerald-600/20 group-hover/link:w-full transition-all duration-300\" data-kid=\"14\"></span>\n    </a>\n  </nav>\n</div>",
