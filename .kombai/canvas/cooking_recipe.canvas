      <i class=\"ti ti-plus text-sm\" data-kid=\"268\"></i>\n        </button>\n      </div>\n    </div>\n\n    \n    <div class=\"mt-10 bg-gradient-to-br from-[#7D9D8A] to-[#576b5d] p-8 rounded-[40px] text-white relative overflow-hidden shadow-xl shadow-emerald-900/10 shrink-0\" data-kid=\"269\">\n      <div class=\"relative z-10\" data-kid=\"270\">\n        <p class=\"text-[9px] font-black uppercase tracking-[0.3em] mb-3 opacity-80\" data-kid=\"271\">Pro Feature</p>\n        <h3 class=\"text-xl font-black mb-4 leading-tight\" data-kid=\"272\">Unlock AI Meal Planner</h3>\n        <p class=\"text-xs text-white/70 font-medium leading-relaxed mb-6\" data-kid=\"273\">Let our AI chef build your entire month based on your health data.</p>\n        <button class=\"w-full py-4 bg-white text-[#576b5d] rounded-2xl text-[10px] font-black uppercase tracking-widest shadow-xl shadow-black/5 hover:bg-emerald-50 transition-all\" data-kid=\"274\">Upgrade Now</button>\n      </div>\n      <div class=\"absolute -bottom-10 -right-10 w-40 h-40 bg-white/10 rounded-full blur-3xl\" data-kid=\"275\"></div>\n    </div>\n  </aside>\n</div>\n",
