      "html": "\n<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');\n\n  :root {\n    --primary: #6a8473; /* Emerald 600 */\n    --primary-hover: #576b5d; /* Emerald 700 */\n    --primary-light: #f5f8f6; /* Emerald 50 */\n    --primary-border: #eaf1ec; /* Emerald 100 */\n    --zinc-900: #18181b;\n    --zinc-600: #52525b;\n    --zinc-500: #71717a;\n    --zinc-400: #a1a1aa;\n    --background: #f8fafc;\n  }\n\n  body {\n    font-family: 'Inter', sans-serif;\n    color: var(--zinc-900);\n    background-color: var(--background);\n    margin: 0;\n  }\n\n  .nav-blur {\n    backdrop-filter: blur(12px);\n    -webkit-backdrop-filter: blur(12px);\n  }\n\n  /* Custom Emerald overrides to match the provided design system */\n  .bg-emerald-primary { background-color: var(--primary); }\n  .text-emerald-primary { color: var(--primary); }\n  .border-emerald-primary { border-color: var(--primary); }\n  .bg-emerald-50-custom { background-color: var(--primary-light); }\n  .border-emerald-100-custom { border-color: var(--primary-border); }\n\n  /* Animation for the search bar appearing */\n  @keyframes slideDown {\n    from { transform: translateY(-10px); opacity: 0; }\n    to { transform: translateY(0); opacity: 1; }\n  }\n  .animate-slide-down {\n    animation: slideDown 0.3s ease-out forwards;\n  }\n</style>\n\n<div class=\"flex flex-col\" data-kid=\"1\">\n  \n  <nav class=\"nav-blur bg-white/70 border-b border-slate-200 relative w-full z-50 h-20 transition-all duration-300\" data-kid=\"2\">\n    <div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-full\" data-kid=\"3\">\n      <div class=\"flex items-center justify-between h-full\" data-kid=\"4\">\n        \n        <div class=\"flex items-center space-x-3 cursor-pointer group\" data-kid=\"5\">\n          <div class=\"w-10 h-10 bg-emerald-primary rounded-xl flex items-center justify-center shadow-xs group-hover:scale-105 transition-transform\" data-kid=\"6\">\n            <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"w-5 h-5 text-white\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-kid=\"7\"><path d=\"M6 13.87A4 4 0 0 1 7.41 6a5.11 5.11 0 0 1 1.05-1.54 5 5 0 0 1 7.08 0 5.11 5.11 0 0 1 1.05 1.54 4 4 0 0 1 1.41 7.87L12 21z\" data-kid=\"8\"></path><path d=\"m12 18-4-4\" data-kid=\"9\"></path><path d=\"m12 18 4-4\" data-kid=\"10\"></path></svg>\n          </div>\n          <span class=\"font-bold text-slate-900 text-xl tracking-tight\" data-kid=\"11\">Naya</span>\n        </div>\n\n        \n        <div class=\"hidden md:flex items-center space-x-8\" data-kid=\"12\">\n          <a href=\"#\" class=\"text-sm font-medium text-slate-900 border-b-2 border-emerald-primary pb-1\" data-kid=\"13\">Recettes</a>\n          <a href=\"#\" class=\"text-sm font-medium text-slate-500 hover:text-slate-900 transition-colors\" data-kid=\"14\">Nutrition</a>\n          <a href=\"#\" class=\"text-sm font-medium text-slate-500 hover:text-slate-900 transition-colors\" data-kid=\"15\">Actualités</a>\n        </div>\n\n        \n        <div class=\"flex items-center space-x-4\" data-kid=\"16\">\n          <button class=\"hidden sm:flex items-center space-x-2 px-6 py-2.5 bg-emerald-primary text-white rounded-full text-sm font-semibold hover:bg-[var(--primary-hover)] transition-all shadow-sm hover:shadow-md\" data-kid=\"17\">\n            <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"w-4 h-4\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-kid=\"18\"><line x1=\"12\" y1=\"5\" x2=\"12\" y2=\"19\" data-kid=\"19\"></line><line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\" data-kid=\"20\"></line></svg>\n            <span data-kid=\"21\">Créer une recette</span>\n          </button>\n          <div class=\"w-10 h-10 rounded-full bg-slate-50 border border-slate-200 flex items-center justify-center cursor-pointer hover:bg-slate-100 transition-colors\" data-kid=\"22\">\n             <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"w-4.5 h-4.5 text-slate-500\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-kid=\"23\"><path d=\"M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2\" data-kid=\"24\"></path><circle cx=\"12\" cy=\"7\" r=\"4\" data-kid=\"25\"></circle></svg>\n          </div>\n        </div>\n      </div>\n    </div>\n  </nav>\n\n  \n  <div class=\"bg-slate-50 border-b border-slate-200 transition-all duration-300\" data-kid=\"26\">\n    <div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8\" data-kid=\"27\">\n      <div class=\"max-w-2xl mx-auto relative animate-slide-down\" data-kid=\"28\">\n        <div class=\"absolute left-4 top-1/2 -translate-y-1/2\" data-kid=\"29\">\n          <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"w-5 h-5 text-zinc-400\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-kid=\"30\"><circle cx=\"11\" cy=\"11\" r=\"8\" data-kid=\"31\"></circle><path d=\"m21 21-4.3-4.3\" data-kid=\"32\"></path></svg>\n        </div>\n        <input type=\"text\" placeholder=\"Rechercher une recette...\" class=\"w-full pl-12 pr-4 py-4 bg-white border border-slate-200 rounded-xl shadow-sm focus:outline-none focus:ring-2 focus:ring-emerald-600 focus:border-transparent text-slate-900 placeholder-slate-400 text-lg\" data-kid=\"33\">\n      </div>\n    </div>\n  </div>\n\n  \n  <main class=\"flex-grow max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-10 pb-24 w-full\" data-kid=\"34\">\n    \n    \n    <div class=\"flex justify-center mb-6\" data-kid=\"35\">\n      <div class=\"inline-flex bg-white border border-slate-200 rounded-2xl p-1 shadow-sm\" data-kid=\"36\">\n        <button class=\"px-6 py-2 rounded-lg font-medium transition-colors min-w-[100px] bg-emerald-p