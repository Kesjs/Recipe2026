    "block_0e3920ba99fe": {
      "type": "block",
      "label": "Navbar - Expanded Search Bar",
      "parentId": "var_f90fbbb6292e",
      "themeId": null,
      "rect": {
        "x": 12320,
        "y": 0,
        "w": 600,
        "h": 0
      },
      "html": "\n<div class=\"flex flex-col items-center justify-center min-h-[500px] bg-[#f9fafb] p-12 font-sans relative overflow-hidden\" data-kid=\"0\">\n  \n  <div class=\"absolute top-[10%] left-[15%] w-96 h-96 bg-emerald-400/30 rounded-full blur-[120px] animate-pulse\" data-kid=\"1\"></div>\n  <div class=\"absolute bottom-[10%] right-[15%] w-[400px] h-[400px] bg-teal-500/20 rounded-full blur-[100px]\" data-kid=\"2\"></div>\n  <div class=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[300px] bg-emerald-100/40 rounded-full blur-[150px] rotate-12\" data-kid=\"3\"></div>\n\n  <style data-kid=\"4\">\n    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap');\n    @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n    .font-sans { font-family: 'Plus Jakarta Sans', sans-serif; }\n\n    .glass-search-panel {\n      backdrop-filter: blur(40px);\n      -webkit-backdrop-filter: blur(40px);\n      background: rgba(255, 255, 255, 0.45);\n      border: 1px solid rgba(255, 255, 255, 0.6);\n    }\n\n    .glass-chip {\n      backdrop-filter: blur(12px);\n      background: rgba(255, 255, 255, 0.3);\n      border: 1px solid rgba(255, 255, 255, 0.4);\n    }\n\n    .glass-chip:hover {\n      background: rgba(16, 185, 129, 0.1);\n      border-color: rgba(16, 185, 129, 0.3);\n      transform: translateY(-2px);\n    }\n\n    /* Custom scrollbar for future-proofing even though not used here */\n    .custom-shadow {\n      box-shadow: \n        0 10px 15px -3px rgba(0, 0, 0, 0.05),\n        0 4px 6px -2px rgba(0, 0, 0, 0.02),\n        inset 0 2px 4px 0 rgba(255, 255, 255, 0.3);\n    }\n  </style>\n\n  <div class=\"w-full max-w-[680px] relative z-10 flex flex-col items-center\" data-kid=\"5\">\n    \n    <div class=\"w-full relative group\" data-kid=\"6\">\n      \n      <div class=\"relative flex items-center w-full h-18 glass-search-panel rounded-2xl px-8 custom-shadow ring-1 ring-white/80 transition-all duration-500 ease-[cubic-bezier(0.23,1,0.32,1)] focus-within:ring-2 focus-within:ring-emerald-500/30 focus-within:bg-white/85 focus-within:rounded-2xl focus-within:shadow-2xl focus-within:shadow-emerald-900/10\" data-kid=\"7\">\n        \n        \n        <div class=\"flex items-center justify-center shrink-0 transition-all duration-500\" data-kid=\"8\">\n          <i class=\"ti ti-search text-zinc-400 group-focus-within:text-emerald-600 text-[26px]\" data-kid=\"9\"></i>\n        </div>\n        \n        \n        <input type=\"text\" placeholder=\"Rechercher une recette, un ingrédient...\" class=\"flex-grow bg-transparent border-none outline-hidden text-zinc-800 placeholder-zinc-400/80 font-semibold text-xl ml-6 tracking-tight\" autofocus data-kid=\"10\">\n\n        \n        <div class=\"flex items-center gap-3 shrink-0 ml-4\" data-kid=\"11\">\n          <kbd class=\"hidden md:flex items-center justify-center h-7 px-2 border border-zinc-200 bg-white/50 text-[10px] font-bold text-zinc-400 rounded-lg shadow-xs group-focus-within:opacity-0 transition-opacity\" data-kid=\"12\">ESC</kbd>\n          <button type=\"button\" class=\"flex items-center justify-center w-11 h-11 rounded-xl text-zinc-400 hover:text-emerald-600 hover:bg-emerald-50/50 transition-all duration-300 active:scale-95 cursor-pointer\" aria-label=\"Fermer la recherche\" data-kid=\"13\">\n            <i class=\"ti ti-x text-2xl\" data-kid=\"14\"></i>\n          </button>\n        </div>\n      </div>\n\n      \n      <div class=\"mt-10 w-full\" data-kid=\"15\">\n        <div class=\"flex items-center gap-4 mb-5\" data-kid=\"16\">\n          <span class=\"text-[11px] font-extrabold text-emerald-900/50 uppercase tracking-[0.25em]\" data-kid=\"17\">Populaire en ce moment</span>\n          <div class=\"h-px flex-grow bg-emerald-900/10\" data-kid=\"18\"></div>\n        </div>\n        \n        <div class=\"flex flex-wrap gap-3\" data-kid=\"19\">\n          <button class=\"px-6 py-2.5 glass-chip rounded-xl text-[13px] font-bold text-emerald-900/70 transition-all cursor-pointer flex items-center gap-2 group/chip\" data-kid=\"20\">\n            <span class=\"text-emerald-500 group-hover/chip:scale-125 transition-transform\" data-kid=\"21\">#</span>\n            QuinoaBowl\n          </button>\n          <button class=\"px-6 py-2.5 glass-chip rounded-xl text-[13px] font-bold text-emerald-900/70 transition-all cursor-pointer flex items-center gap-2 group/chip\" data-kid=\"22\">\n            <span class=\"text-emerald-500 group-hover/chip:scale-125 transition-transform\" data-kid=\"23\">#</span>\n            VeganPancakes\n          </button>\n          <button class=\"px-6 py-2.5 glass-chip rounded-xl text-[13px] font-bold text-emerald-900/70 transition-all cursor-pointer flex items-center gap-2 group/chip\" data-kid=\"24\">\n            <span class=\"text-emerald-500 group-hover/chip:scale-125 transition-transform\" data-kid=\"25\">#</span>\n            SansGluten\n          </button>\n          <button class=\"px-6 py-2.5 glass-chip rounded-xl text-[13px] font-bold text-emerald-900/70 transition-all cursor-pointer flex items-center gap-2 group/chip\" data-kid=\"26\">\n            <span class=\"text-emerald-500 group-hover/chip:scale-125 transition-transform\" data-kid=\"27\">#</span>\n            DetoxSmoothie\n          </button>\n          <button class=\"px-6 py-2.5 glass-chip rounded-xl text-[13px] font-bold text-emerald-900/70 transition-all cursor-pointer flex items-center gap-2 group/chip\" data-kid=\"28\">\n            <span class=\"text-emerald-500 group-hover/chip:scale-125 transition-transform\" data-kid=\"29\">#</span>\n            RecetteHiver\n          </button>\n        </div>\n      </div>\n    </div>\n  </div>\n</div>\n",
