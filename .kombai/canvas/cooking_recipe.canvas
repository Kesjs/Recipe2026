      "html": "\n<div class=\"bg-[#f4f4f5] min-h-[1000px] text-zinc-900 font-['Inter'] pb-20\" data-kid=\"0\">\n  <style data-kid=\"1\">\n    @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=Inter:wght@400;500;600;700&display=swap');\n    @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n    .font-space { font-family: 'Space Grotesk', sans-serif; }\n    \n    .hide-scrollbar::-webkit-scrollbar { display: none; }\n    .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }\n\n    .bento-card {\n      transition: all 0.4s cubic-bezier(0.23, 1, 0.32, 1);\n    }\n\n    .sticker-shadow {\n      box-shadow: 0 4px 20px -2px rgba(251, 191, 36, 0.4);\n    }\n  </style>\n\n  \n  <nav class=\"relative z-50 bg-white/80 backdrop-blur-xl border-b border-zinc-200/50 px-6 py-4\" data-kid=\"2\">\n    <div class=\"max-w-7xl mx-auto flex items-center justify-between\" data-kid=\"3\">\n      <div class=\"flex items-center gap-2 group cursor-pointer\" data-kid=\"4\">\n        <div class=\"w-10 h-10 bg-[#7D9D8A] rounded-xl flex items-center justify-center text-white transition-transform group-hover:rotate-12\" data-kid=\"5\">\n          <i class=\"ti ti-chef-hat text-2xl\" data-kid=\"6\"></i>\n        </div>\n        <span class=\"font-space text-2xl font-bold tracking-tight\" data-kid=\"7\">Naya</span>\n      </div>\n      \n      <div class=\"hidden md:flex items-center gap-8\" data-kid=\"8\">\n        <a href=\"#\" class=\"text-sm font-semibold hover:text-[#7D9D8A] transition-colors border-b-2 border-[#7D9D8A] pb-1\" data-kid=\"9\">Recipes</a>\n        <a href=\"#\" class=\"text-sm font-semibold text-zinc-500 hover:text-zinc-900 transition-colors\" data-kid=\"10\">Nutrition</a>\n        <a href=\"#\" class=\"text-sm font-semibold text-zinc-500 hover:text-zinc-900 transition-colors\" data-kid=\"11\">Community</a>\n        <a href=\"#\" class=\"text-sm font-semibold text-zinc-500 hover:text-zinc-900 transition-colors\" data-kid=\"12\">News</a>\n      </div>\n\n      <div class=\"flex items-center gap-4\" data-kid=\"13\">\n        <div class=\"hidden sm:flex items-center gap-2 bg-zinc-100 rounded-full px-4 py-2 border border-zinc-200\" data-kid=\"14\">\n          <i class=\"ti ti-search text-zinc-400\" data-kid=\"15\"></i>\n          <input type=\"text\" placeholder=\"Search...\" class=\"bg-transparent border-none outline-none text-sm w-32 focus:w-48 transition-all\" data-kid=\"16\">\n        </div>\n        <button class=\"p-2.5 bg-zinc-100 rounded-full hover:bg-zinc-200 transition-colors\" data-kid=\"17\">\n          <i class=\"ti ti-bell text-xl\" data-kid=\"18\"></i>\n        </button>\n        <img src=\"https://i.pravatar.cc/150?u=naya_user\" class=\"w-10 h-10 rounded-full border-2 border-white shadow-sm\" alt=\"Avatar\" data-kid=\"19\">\n      </div>\n    </div>\n  </nav>\n\n  <main class=\"max-w-7xl mx-auto px-6 pt-10 space-y-16\" data-kid=\"20\">\n    \n    \n    <section class=\"grid grid-cols-1 lg:grid-cols-3 grid-rows-2 gap-6 h-[600px] lg:h-[540px]\" data-kid=\"21\">\n      \n      <div class=\"lg:col-span-2 lg:row-span-2 rounded-[40px] overflow-hidden relative group bento-card shadow-lg\" data-kid=\"22\">\n        <img src=\"https://images.pexels.com/photos/8286753/pexels-photo-8286753.jpeg?auto=compress&cs=tinysrgb&w=1400&q=85\" class=\"w-full h-full object-cover transition-transform duration-1000 group-hover:scale-105\" alt=\"Salmon Poke Bowl\" decoding=\"async\" loading=\"lazy\" data-kid=\"23\">\n        <div class=\"absolute inset-0 bg-gradient-to-t from-black/90 via-black/30 to-transparent\" data-kid=\"24\"></div>\n        <div class=\"absolute bottom-10 left-10\" data-kid=\"25\">\n          <div class=\"flex items-center gap-2 mb-6\" data-kid=\"26\">\n            <span class=\"px-4 py-1.5 bg-[#fbbf24] text-zinc-900 text-xs font-bold rounded-full font-space tracking-widest uppercase shadow-lg shadow-amber-400/20\" data-kid=\"27\">Star Recipe</span>\n            <div class=\"flex gap-1\" data-kid=\"28\">\n              <i class=\"ti ti-star-filled text-amber-400 text-xs\" data-kid=\"29\"></i>\n              <i class=\"ti ti-star-filled text-amber-400 text-xs\" data-kid=\"30\"></i>\n              <i class=\"ti ti-star-filled text-amber-400 text-xs\" data-kid=\"31\"></i>\n              <i class=\"ti ti-star-filled text-amber-400 text-xs\" data-kid=\"32\"></i>\n              <i class=\"ti ti-star-filled text-amber-400 text-xs\" data-kid=\"33\"></i>\n            </div>\n          </div>\n          <h1 class=\"text-4xl md:text-6xl font-space text-white font-bold leading-tight drop-shadow-lg\" data-kid=\"34\">Fresh Salmon<br data-kid=\"35\">Poke Bowl</h1>\n          <p class=\"text-zinc-300 mt-4 max-w-md text-lg font-medium opacity-0 group-hover:opacity-100 transition-opacity duration-500\" data-kid=\"36\">A colorful explosion of fresh flavors, featuring marinated premium salmon and crispy vegetables.</p>\n        </div>\n      </div>\n\n      \n      <div class=\"bg-[#7D9D8A] rounded-[40px] p-8 flex flex-col justify-between text-white bento-card shadow-lg hover:-translate-y-1 border border-white/10\" data-kid=\"37\">\n        <div data-kid=\"38\">\n          <div class=\"flex items-center justify-between\" data-kid=\"39\">\n            <p class=\"text-[10px] font-bold opacity-80 uppercase tracking-[0.2em] font-space\" data-kid=\"40\">Nutrition Facts</p>\n            <div class=\"w-8 h-8 bg-white/10 rounded-xl flex items-center justify-center\" data-kid=\"41\">\n              <i class=\"ti ti-bolt text-lg text-amber-300\" data-kid=\"42\"></i>\n            </div>\n          </div>\n          <div class=\"mt-8 flex items-baseline gap-2\" data-kid=\"43\">\n            <span class=\"text-7xl font-space font-bold tracking-tighter\" data-kid=\"44\">410</span>\n            <span class=\"text-2xl font-medium opacity-80\" data-kid=\"45\">Kcal</span>\n          </div>\n        </div>\n        <div class=\"space-y-5\" data-kid=\"46\">\n          <div class=\"space-y-2.5\" data-kid=\"47\">\n            <div class=\"flex justify-between text-[10px] font-bold tracking-widest uppercase\" data-kid=\"48\">\n              <span class=\"opacity-80\" data-kid=\"49\">Protein</span>\n              <span class=\"text-amber-300\" data-kid=\"50\">24g • 75%</span>\n            </div>\n            <div class=\"h-2 w-full bg-white/10 rounded-full overflow-hidden border border-white/5\" data-kid=\"51\">\n              <div class=\"h-full bg-linear-to-r from-white/80 to-white w-3/4 rounded-full shadow-[0_0_12px_rgba(255,255,255,0.4)]\" data-kid=\"52\"></div>\n            </div>\n          </div>\n          <div class=\"space-y-2.5\" data-kid=\"53\">\n            <div class=\"flex justify-between text-[10px] font-bold tracking-widest uppercase\" data-kid=\"54\">\n              <span class=\"opacity-80\" data-kid=\"55\">Carbs</span>\n              <span class=\"text-amber-300\" data-kid=\"56\">45g • 50%</span>\n            </div>\n            <div class=\"h-2 w-full bg-white/10 rounded-full overflow-hidden border border-white/5\" data-kid=\"57\">\n              <div class=\"h-full bg-linear-to-r from-white/80 to-white w-1/2 rounded-full shadow-[0_0_12px_rgba(255,255,255,0.4)]\" data-kid=\"58\"></div>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      \n      <div class=\"bg-white rounded-[40px] p-8 flex flex-col justify-between border border-zinc-200 bento-card shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all\" data-kid=\"59\">\n        <div class=\"flex items-start justify-between\" data-kid=\"60\">\n          <div class=\"flex -space-x-3 overflow-hidden\" data-kid=\"61\">\n            <img class=\"inline-block h-12 w-12 rounded-full ring-4 ring-white\" src=\"https://i.pravatar.cc/150?u=user1\" alt=\"Cooked by\" data-kid=\"62\">\n            <img class=\"inline-block h-12 w-12 rounded-full ring-4 ring-white\" src=\"https://i.pravatar.cc/150?u=user2\" alt=\"Cooked by\" data-kid=\"63\">\n            <img class=\"inline-block h-12 w-12 rounded-full ring-4 ring-white\" src=\"https://i.pravatar.cc/150?u=user3\" alt=\"Cooked by\" data-kid=\"64\">\n            <div class=\"flex items-center justify-center h-12 w-12 rounded-full bg-zinc-100 ring-4 ring-white text-xs font-bold text-zinc-500 tracking-tighter\" data-kid=\"65\">+2.4k</div>\n          </div>\n          <div class=\"bg-[#7D9D8A]/10 p-2.5 rounded-2xl\" data-kid=\"66\">\n            <i class=\"ti ti-flame text-[#7D9D8A] text-xl\" data-kid=\"67\"></i>\n          </div>\n        </div>\n        <div class=\"mt-2\" data-kid=\"68\">\n          <p class=\"text-zinc-500 font-semibold mb-6\" data-kid=\"69\">Join <span class=\"text-zinc-900\" data-kid=\"70\">2,400+</span> home chefs who cooked this today</p>\n          <button class=\"w-full bg-zinc-900 text-white rounded-3xl py-5 flex items-center justify-center gap-3 hover:bg-zinc-800 transition-all active:scale-95 group overflow-hidden relative\" data-kid=\"71\">\n            <div class=\"absolute inset-0 bg-gradient-to-r from-transparent via-white/5 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-700\" data-kid=\"72\"></div>\n            <span class=\"font-space font-bold tracking-widest text-sm\" data-kid=\"73\">START COOKING</span>\n            <i class=\"ti ti-player-play-filled text-lg text-amber-400 group-hover:scale-125 transition-transform\" data-kid=\"74\"></i>\n          </button>\n        </div>\n      </div>\n    </section>\n\n    \n    <section data-kid=\"75\">\n      <div class=\"flex items-center justify-between mb-10\" data-kid=\"76\">\n        <div data-kid=\"77\">\n          <h2 class=\"text-4xl font-space font-bold tracking-tight\" data-kid=\"78\">Visual Categories</h2>\n          <p class=\"text-zinc-500 mt-2 text-lg font-medium\" data-kid=\"79\">Explore by your favorite cuisine style</p>\n        </div>\n        <div class=\"flex gap-3\" data-kid=\"80\">\n          <button class=\"p-3 bg-white rounded-full border border-zinc-200 hover:bg-zinc-50 transition-all shadow-sm active:scale-90\" data-kid=\"81\"><i class=\"ti ti-chevron-left\" data-kid=\"82\"></i></button>\n          <button class=\"p-3 bg-white rounded-full border border-zinc-200 hover:bg-zinc-50 transition-all shadow-sm active:scale-90\" data-kid=\"83\"><i class=\"ti ti-chevron-right\" data-kid=\"84\"></i></button>\n        </div>\n      </div>\n      \n      <div class=\"flex gap-6 overflow-x-auto hide-scrollbar pb-6 snap-x\" data-kid=\"85\">\n        \n        <div class=\"flex-shrink-0 w-44 h-44 rounded-[32px] overflow-hidden relative group cursor-pointer bento-card snap-start shadow-sm border border-zinc-200/50\" data-kid=\"86\">\n          <img src=\"https://images.unsplash.com/photo-1592222720114-38bcd5fc2c14?auto=format&w=400&q=80&fit=crop\" class=\"w-full h-full object-cover transition-transform duration-700 group-hover:scale-110\" alt=\"Breakfast\" decoding=\"async\" loading=\"lazy\" data-kid=\"87\">\n          <div class=\"absolute inset-0 bg-black/45 flex items-center justify-center p-4 backdrop-blur-[1px] group-hover:bg-black/25 group-hover:backdrop-blur-0 transition-all duration-500\" data-kid=\"88\">\n            <span class=\"text-white font-space font-bold text-2xl text-center group-hover:scale-110 transition-transform drop-shadow-[0_2px_4px_rgba(0,0,0,0.5)]\" data-kid=\"89\">Breakfast</span>\n          </div>\n        </div>\n        \n        <div class=\"flex-shrink-0 w-44 h-44 rounded-[32px] overflow-hidden relative group cursor-pointer bento-card snap-start shadow-sm border border-zinc-200/50\" data-kid=\"90\">\n          <img src=\"https://images.unsplash.com/photo-1549736624-81a2ca809ad7?auto=format&w=400&q=80&fit=crop\" class=\"w-full h-full object-cover transition-transform duration-700 group-hover:scale-110\" alt=\"Vegan\" decoding=\"async\" loading=\"lazy\" data-kid=\"91\">\n          <div class=\"absolute inset-0 bg-black/45 flex items-center justify-center p-4 backdrop-blur-[1px] group-hover:bg-black/25 group-hover:backdrop-blur-0 transition-all duration-500\" data-kid=\"92\">\n            <span class=\"text-white font-space font-bold text-2xl text-center group-hover:scale-110 transition-transform drop-shadow-[0_2px_4px_rgba(0,0,0,0.5)]\" data-kid=\"93\">Vegan</span>\n          </div>\n        </div>\n        \n        <div class=\"flex-shrink-0 w-44 h-44 rounded-[32px] overflow-hidden relative group cursor-pointer bento-card snap-start border-4 border-[#7D9D8A] shadow-lg shadow-[#7D9D8A]/20\" data-kid=\"94\">\n          <img src=\"https://images.unsplash.com/photo-1605807646983-377bc5a76493?auto=format&w=400&q=80&fit=crop\" class=\"w-full h-full object-cover transition-transform duration-700 group-hover:scale-110\" alt=\"Desserts\" decoding=\"async\" loading=\"lazy\" data-kid=\"95\">\n          <div class=\"absolute inset-0 bg-black/35 flex items-center justify-center p-4 backdrop-blur-[1px] group-hover:bg-black/15 group-hover:backdrop-blur-0 transition-all duration-500\" data-kid=\"96\">\n            <span class=\"text-white font-space font-bold text-2xl text-center group-hover:scale-110 transition-transform drop-shadow-[0_2px_4px_rgba(0,0,0,0.5)]\" data-kid=\"97\">Desserts</span>\n          </div>\n        </div>\n        \n        <div class=\"flex-shrink-0 w-44 h-44 rounded-[32px] overflow-hidden relative group cursor-pointer bento-card snap-start\" data-kid=\"98\">\n          <img src=\"https://images.unsplash.com/photo-1546069901-ba9599a7e63c?auto=format&w=400&q=80&fit=crop\" class=\"w-full h-full object-cover transition-transform duration-700 group-hover:scale-110\" alt=\"Salads\" decoding=\"async\" loading=\"lazy\" data-kid=\"99\">\n          <div class=\"absolute inset-0 bg-black/40 flex items-center justify-center p-4 backdrop-blur-[1px] group-hover:backdrop-blur-0 transition-all\" data-kid=\"100\">\n            <span class=\"text-white font-space font-bold text-xl text-center\" data