 data-kid=\"235\">\n        </div>\n        <div class=\"flex-1 min-w-0\" data-kid=\"236\">\n          <h5 class=\"text-[13px] font-bold text-zinc-900 group-hover:text-[#576b5d] truncate leading-tight mb-1\" data-kid=\"237\">Avocado Toast</h5>\n          <p class=\"text-[10px] text-zinc-400 font-bold uppercase tracking-tighter\" data-kid=\"238\">5m • 310 kcal</p>\n          <div class=\"flex gap-1 mt-1\" data-kid=\"239\">\n            <span class=\"w-1 h-1 rounded-full bg-emerald-400\" data-kid=\"240\"></span>\n            <span class=\"w-1 h-1 rounded-full bg-emerald-400\" data-kid=\"241\"></span>\n            <span class=\"w-1 h-1 rounded-full bg-zinc-200\" data-kid=\"242\"></span>\n          </div>\n        </div>\n        <button class=\"w-8 h-8 rounded-full bg-white shadow-xs border border-zinc-100 flex items-center justify-center text-[#7D9D8A] hover:bg-[#7D9D8A] hover:text-white transition-all shrink-0\" data-kid=\"243\">\n          <i class=\"ti ti-plus text-sm\" data-kid=\"244\"></i>\n        </button>\n      </div>\n\n      \n      <div class=\"group flex items-center gap-4 p-3 rounded-3xl border border-zinc-50 hover:border-zinc-100 hover:bg-zinc-50 transition-all cursor-pointer\" data-kid=\"245\">\n        <div class=\"w-16 h-16 rounded-2xl overflow-hidden shrink-0 shadow-xs\" data-kid=\"246\">\n          <img src=\"https://images.unsplash.com/photo-1621797350488-fb28c9217e3b?auto=format&w=200&q=80&fit=crop\" alt=\"Bowl\" class=\"w-full h-full object-cover\" decoding=\"async\" loading=\"lazy\" data-kid=\"247\">\n        </div>\n        <div class=\"flex-1 min-w-0\" data-kid=\"248\">\n          <h5 class=\"text-[13px] font-bold text-zinc-900 group-hover:text-[#576b5d] truncate leading-tight mb-1\" data-kid=\"249\">Acai Berry Bowl</h5>\n          <p class=\"text-[10px] text-zinc-400 font-bold uppercase tracking-tighter\" data-kid=\"250\">12m • 420 kcal</p>\n          <div class=\"flex gap-1 mt-1\" data-kid=\"251\">\n            <span class=\"w-1 h-1 rounded