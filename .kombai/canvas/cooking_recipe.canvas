te font-bold rounded-2xl hover:bg-emerald-900 transition-all shadow-2xl shadow-zinc-900/20 active:scale-95 flex items-center space-x-3 w-fit\" data-kid=\"158\">\n            <span data-kid=\"159\">Commencer l'expérience</span>\n            <i class=\"ti ti-arrow-right\" data-kid=\"160\"></i>\n          </button>\n        </div>\n      </div>\n      <div class=\"lg:w-[45%] h-[500px] lg:h-auto relative\" data-kid=\"161\">\n        <img src=\"https://images.unsplash.com/photo-1734113542343-fc916b32ef17?auto=format&w=1000&q=80&fit=crop\" alt=\"Cooking Preparation\" class=\"absolute inset-0 w-full h-full object-cover\" decoding=\"async\" loading=\"lazy\" data-kid=\"162\">\n        <div class=\"absolute inset-0 bg-emerald-950/20 mix-blend-multiply\" data-kid=\"163\"></div>\n      </div>\n    </div>\n  </section>\n\n  \n  <footer class=\"bg-zinc-950 text-zinc-400 py-32 px-10 border-t border-zinc-800/50\" data-kid=\"164\">\n    <div class=\"max-w-7xl mx-auto\" data-kid=\"165\">\n      <div class=\"grid grid-cols-1 md:grid-cols-12 gap-16 mb-24\" data-kid=\"166\">\n        <div class=\"md:col-span-5\" data-kid=\"167\">\n          <div class=\"flex items-center space-x-2 mb-10 group cursor-pointer\" data-kid=\"168\">\n            <div class=\"w-12 h-12 bg-emerald-600 rounded-xl flex items-center justify-center text-white shadow-lg transition-transform\" data-kid=\"169\">\n              <i class=\"ti ti-leaf text-3xl\" data-kid=\"170\"></i>\n            </div>\n            <span class=\"font-bold text-4xl tracking-tighter text-white\" data-kid=\"171\">Naya</span>\n          </div>\n          <p class=\"text-zinc-500 text-xl leading-relaxed max-w-sm mb-12\" data-kid=\"172\">\n            Mangez mieux, vivez mieux. Célébrons ensemble les richesses de la cuisine saine et créative.\n          </p>\n          <div class=\"flex items-center space-x-6\" data-kid=\"173\">\n            <a href=\"#\" class=\"w-14 h-14 rounded-full bg-zinc-800/50 border border-zinc-700/50 flex items-cente