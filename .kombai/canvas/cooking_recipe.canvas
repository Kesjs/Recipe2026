      "html": "\n<div class=\"flex min-h-[900px] w-full bg-[#f8fafc] font-['Inter',sans-serif] text-[#0f172a]\" data-kid=\"0\">\n  \n  <link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" data-kid=\"1\">\n  <style data-kid=\"2\">\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap');\n    \n    .hide-scrollbar::-webkit-scrollbar {\n      display: none;\n    }\n    .hide-scrollbar {\n      -ms-overflow-style: none;\n      scrollbar-width: none;\n    }\n    \n    .glass-card {\n      background: rgba(255, 255, 255, 0.8);\n      backdrop-filter: blur(8px);\n    }\n  </style>\n\n  \n  <aside class=\"flex flex-col w-72 bg-white border-r border-zinc-200 p-8 shrink-0\" data-kid=\"3\">\n    <div class=\"flex items-center gap-3 mb-12\" data-kid=\"4\">\n      <div class=\"w-10 h-10 bg-[#7D9D8A] rounded-xl flex items-center justify-center text-white shadow-lg shadow-emerald-500/20\" data-kid=\"5\">\n        <i class=\"ti ti-leaf text-2xl\" data-kid=\"6\"></i>\n      </div>\n      <span class=\"text-xl font-extrabold tracking-tight text-zinc-900\" data-kid=\"7\">GreenPlate</span>\n    </div>\n\n    <nav class=\"flex-1 space-y-2\" data-kid=\"8\">\n      <a href=\"#\" class=\"flex items-center gap-4 px-5 py-4 bg-[#f0f5f2] text-[#7D9D8A] rounded-2xl font-bold transition-all border border-[#7D9D8A]/10\" data-kid=\"9\">\n        <i class=\"ti ti-layout-dashboard text-xl\" data-kid=\"10\"></i>\n        Dashboard\n      </a>\n      <a href=\"#\" class=\"flex items-center gap-4 px-5 py-4 text-zinc-400 hover:bg-zinc-50 hover:text-zinc-600 rounded-2xl transition-all font-medium\" data-kid=\"11\">\n        <i class=\"ti ti-meat text-xl\" data-kid=\"12\"></i>\n        My Recipes\n      </a>\n      <a href=\"#\" class=\"flex items-center gap-4 px-5 py-4 text-zinc-400 hover:bg-zinc-50 hover:text-zinc-600 rounded-2xl transition-all font-medium\" data-kid=\"13\">\n        <i class=\"ti ti-shopping-cart text-xl\" data-kid=\"14\"></i>\n        Grocery List\n      </a>\n      <a href=\"#\" class=\"flex items-center gap-4 px-5 py-4 text-zinc-400 hover:bg-zinc-50 hover:text-zinc-600 rounded-2xl transition-all font-medium\" data-kid=\"15\">\n        <i class=\"ti ti-chart-bar text-xl\" data-kid=\"16\"></i>\n        Analytics\n      </a>\n      <a href=\"#\" class=\"flex items-center gap-4 px-5 py-4 text-zinc-400 hover:bg-zinc-50 hover:text-zinc-600 rounded-2xl transition-all font-medium\" data-kid=\"17\">\n        <i class=\"ti ti-settings text-xl\" data-kid=\"18\"></i>\n        Settings\n      </a>\n    </nav>\n\n    <div class=\"mt-auto pt-10 border-t border-zinc-100\" data-kid=\"19\">\n      \n      <div class=\"bg-[#f5f8f6] p-6 rounded-3xl mb-8 border border-[#d5e3d9]/50\" data-kid=\"20\">\n        <div class=\"flex justify-between items-center mb-4\" data-kid=\"21\">\n          <span class=\"text-xs font-bold text-[#576b5d] uppercase tracking-wider\" data-kid=\"22\">Weekly Goal</span>\n          <span class=\"text-xs font-black text-amber-500 tracking-widest\" data-kid=\"23\">4 / 7</span>\n        </div>\n        <div class=\"h-2 w-full bg-zinc-200/50 rounded-full overflow-hidden\" data-kid=\"24\">\n          <div class=\"h-full bg-[#7D9D8A] rounded-full shadow-sm\" style=\"width: 57%\" data-kid=\"25\"></div>\n        </div>\n        <p class=\"text-[10px] text-zinc-500 mt-3 font-medium leading-relaxed italic\" data-kid=\"26\">3 more days to reach your health goal!</p>\n      </div>\n\n      \n      <div class=\"flex items-center gap-4\" data-kid=\"27\">\n        <img src=\"https://i.pravatar.cc/150?u=chef_eliza\" alt=\"Eliza\" class=\"w-12 h-12 rounded-2xl border-2 border-white shadow-md\" decoding=\"async\" loading=\"lazy\" data-kid=\"28\">\n        <div class=\"flex-1 min-w-0\" data-kid=\"29\">\n          <p class=\"text-sm font-bold text-zinc-900 truncate leading-tight\" data-kid=\"30\">Eliza Thorne</p>\n          <p class=\"text-xs text-zinc-400 truncate\" data-kid=\"31\">Standard Plan</p>\n        </div>\n        <button class=\"w-10 h-10 rounded-xl hover:bg-zinc-100 flex items-center justify-center text-zinc-400 transition-colors\" data-kid=\"32\">\n          <i class=\"ti ti-dots-vertical text-xl\" data-kid=\"33\"></i>\n        </button>\n      </div>\n    </div>\n  </aside>\n\n  \n  <main class=\"flex-1 overflow-y-auto h-full flex flex-col\" data-kid=\"34\">\n    \n    <header class=\"flex items-center justify-between px-10 py-8\" data-kid=\"35\">\n      <div data-kid=\"36\">\n        <h1 class=\"text-3xl font-black text-zinc-900 tracking-tight mb-1\" data-kid=\"37\">Good Morning, Eliza!</h1>\n        <p class=\"text-zinc-400 font-medium\" data-kid=\"38\">Plan your meals for <span class=\"text-zinc-900\" data-kid=\"39\">Oct 12 - Oct 18</span></p>\n      </div>\n      <div class=\"flex items-center gap-4\" data-kid=\"40\">\n        <button class=\"flex items-center gap-2 px-6 py-3 bg-white border border-zinc-200 rounded-2xl text-sm font-bold text-zinc-600 hover:bg-zinc-50 transition-all shadow-sm\" data-kid=\"41\">\n          <i class=\"ti ti-calendar-event text-lg text-[#7D9D8A]\" data-kid=\"42\"></i>\n          This Week\n          <i class=\"ti ti-chevron-down text-xs ml-2\" data-kid=\"43\"></i>\n        </button>\n        <button class=\"flex items-center gap-2 px-8 py-3 bg-[#7D9D8A] text-white rounded-2xl text-sm font-bold hover:bg-[#6a8473] transition-all shadow-lg shadow-emerald-500/20\" data-kid=\"44\">\n          <i class=\"ti ti-plus text-lg\" data-kid=\"45\"></i>\n          Add New Recipe\n        </button>\n      </div>\n    </header>\n\n    \n    <section class=\"grid grid-cols-4 gap-6 px-10 mb-8 shrink-0\" data-kid=\"46\">\n      \n      <div class=\"bg-white p-7 rounded-[32px] border border-zinc-200/50 shadow-sm flex flex-col justify-between hover:shadow-md transition-shadow\" data-kid=\"47\">\n        <div class=\"flex items-start justify-between mb-4\" data-kid=\"48\">\n          <div data-kid=\"49\">\n            <p class=\"text-[10px] font-black text-zinc-400 uppercase tracking-[0.2em] mb-2\" data-kid=\"50\">Calories</p>\n            <div class=\"flex items-baseline gap-1\" data-kid=\"51\">\n              <span class=\"text-3xl font-black text-zinc-900 tracking-tighter\" data-kid=\"52\">12,450</span>\n              <span class=\"text-xs font-bold text-zinc-400 uppercase\" data-kid=\"53\">kcal</span>\n            </div>\n          </div>\n          <div class=\"w-12 h-12 bg-amber-50 text-amber-500 rounded-2xl flex items-center justify-center shadow-inner\" data-kid=\"54\">\n            <i class=\"ti ti-flame text-2xl\" data-kid=\"55\"></i>\n          </div>\n        </div>\n        <div class=\"space-y-2\" data-kid=\"56\">\n          <div class=\"flex justify-between text-[10px] font-bold\" data-kid=\"57\">\n            <span class=\"text-zinc-500\" data-kid=\"58\">Daily Goal</span>\n            <span class=\"text-zinc-900\" data-kid=\"59\">88%</span>\n          </div>\n          <div class=\"h-2 w-full bg-zinc-100 rounded-full overflow-hidden\" data-kid=\"60\">\n            <div class=\"h-full bg-amber-400 rounded-full\" style=\"width: 88%\" data-kid=\"61\"></div>\n          </div>\n        </div>\n      </div>\n\n      \n      <div class=\"bg-white p-7 rounded-[32px] border border-zinc-200/50 shadow-sm hover:shadow-md transition-shadow\" data-kid=\"62\">\n        <div class=\"flex items-start justify-between mb-2\" data-kid=\"63\">\n          <div data-kid=\"64\">\n            <p class=\"text-[10px] font-black text-zinc-400 uppercase tracking-[0.2em] mb-2\" data-kid=\"65\">Protein</p>\n            <span class=\"text-3xl font-black text-zinc-900 tracking-tighter\" data-kid=\"66\">450g</span>\n          </div>\n          <div class=\"w-12 h-12 bg-red-50 text-red-500 rounded-2xl flex items-center justify-center shadow-inner\" data-kid=\"67\">\n            <i class=\"ti ti-meat text-2xl\" data-kid=\"68\"></i>\n          </div>\n        </div>\n        <p class=\"text-[11px] font-bold text-red-600/70\" data-kid=\"69\">+12% from last week</p>\n      </div>\n\n      \n      <div class=\"bg-white p-7 rounded-[32px] border border-zinc-200/50 shadow-sm hover:shadow-md transition-shadow\" data-kid=\"70\">\n        <div class=\"flex items-start justify-between mb-2\" data-kid=\"71\">\n          <div data-kid=\"72\">\n            <p class=\"text-[10px] font-black text-zinc-400 uppercase tracking-[0.2em] mb-2\" data-kid=\"73\">Carbs</p>\n            <span class=\"text-3xl font-black text-zinc-900 tracking-tighter\" data-kid=\"74\">820g</span>\n          </div>\n          <div class=\"w-12 h-12 bg-emerald-50 text-[#7D9D8A] rounded-2xl flex items-center justify-center shadow-inner\" data-kid=\"75\">\n            <i class=\"ti ti-wheat text-2xl\" data-kid=\"76\"></i>\n          </div>\n        </div>\n        <p class=\"text-[11px] font-bold text-[#7D9D8A]/70\" data-kid=\"77\">Within target range</p>\n      </div>\n\n      \n      <div class=\"bg-white p-7 rounded-[32px] border border-zinc-200/50 shadow-sm hover:shadow-md transition-shadow\" data-kid=\"78\">\n        <div class=\"flex items-start justify-between mb-2\" data-kid=\"79\">\n          <div data-kid=\"80\">\n            <p class=\"text-[10px] font-black text-zinc-400 uppercase tracking-[0.2em] mb-2\" data-kid=\"81\">Fats</p>\n            <span class=\"text-3xl font-black text-zinc-900 tracking-tighter\" data-kid=\"82\">310g</span>\n          </div>\n          <div class=\"w-12 h-12 bg-blue-50 text-blue-500 rounded-2xl flex items-center justify-center shadow-inner\" data-kid=\"83\">\n            <i class=\"ti ti-droplet text-2xl\" data-kid=\"84\"></i>\n          </div>\n        </div>\n        <p class=\"text-[11px] font-bold text-blue-600/70\" data-kid=\"85\">Moderate intake</p>\n      </div>\n    </section>\n\n    \n    <section class=\"flex-1 overflow-x-auto px-10 pb-12 hide-scrollbar\" data-kid=\"86\">\n      <div class=\"flex gap-8 min-w-max h-full\" data-kid=\"87\">\n        \n        \n        <div class=\"w-[320px] flex flex-col gap-6\" data-kid=\"88\">\n          <div class=\"relative py-6 px-1 mb-2\" data-kid=\"89\">\n            <span class=\"absolute top-0 right-0 text-[100px] font-black text-zinc-200/20 pointer-events-none select-none leading-none\" data-kid=\"90\">12</span>\n            <h3 class=\"relative text-2xl font-black text-zinc-900 tracking-tight\" data-kid=\"91\">Monday</h3>\n            <p class=\"relative text-[10px] font-black text-[#7D9D8A] uppercase tracking-[0.2em]\" data-kid=\"92\">Active Plan</p>\n          </div>\n\n          <div class=\"flex flex-col gap-5\" data-kid=\"93\">\n            <div class=\"group h-20 rounded-3xl border-2 border-dashed border-zinc-100 bg-zinc-50/30 flex items-center gap-4 px-6 hover:bg-emerald-50/50 hover:border-[#7D9D8A]/20 transition-all cursor-pointer\" data-kid=\"94\">\n              <div class=\"w-9 h-9 rounded-full bg-white flex items-center justify-center text-[#7D9D8A] shadow-xs group-hover:bg-[#7D9D8A] group-hover:text-white transition-all\" data-kid=\"95\">\n                <i class=\"ti ti-plus text-lg\" data-kid=\"96\"></i>\n              </div>\n              <span class=\"text-xs font-bold text-zinc-400 group-hover:text-[#576b5d]\" data-kid=\"97\">Add Breakfast</span>\n            </div>\n\n            <div class=\"group bg-white rounded-[32px] border border-zinc-100 shadow-sm overflow-hidden hover:shadow-xl hover:-translate-y-1 transition-all duration-300\" data-kid=\"98\">\n              <div class=\"h-44 relative\" data-kid=\"99\">\n                <img src=\"https://images.unsplash.com/photo-1560717845-968823efbee1?auto=format&w=600&q=80&fit=crop\" alt=\"Salmon\" class=\"w-full h-full object-cover\" decoding=\"async\" loading=\"lazy\" data-kid=\"100\">\n                <div class=\"absolute inset-0 bg-gradient-to-b from-black/20 via-transparent to-transparent opacity-60\" data-kid=\"101\"></div>\n                <div class=\"absolute top-4 left-4 flex gap-2 z-10\" data-kid=\"102\">\n                   <span class=\"px-3 py-1 bg-white/95 backdrop-blur-md rounded-lg text-[10px] font-black text-[#7D9D8A] shadow-sm uppercase\" data-kid=\"103\">Lunch</span>\n                </div>\n                <button class=\"absolute top-4 right-4 w-8 h-8 bg-white/90 backdrop-blur-md rounded-full flex items-center justify-center text-amber-500 shadow-sm z-10\" data-kid=\"104\">\n                  <i class=\"ti ti-star-filled text-sm\" data-kid=\"105\"></i>\n                </button>\n              </div>\n              <div class=\"p-6\" data-kid=\"106\">\n                <h4 class=\"text-md font-bold text-zinc-900 mb-3 group-hover:text-[#576b5d] transition-colors leading-snug\" data-kid=\"107\">Grilled Salmon with Asparagus</h4>\n                <div class=\"flex items-center justify-between\" data-kid=\"108\">\n                  <div class=\"flex items-center gap-3 text-[11px] font-bold text-zinc-400\" data-kid=\"109\">\n                    <span class=\"flex items-center gap-1\" data-kid=\"110\"><i class=\"ti ti-clock-filled text-[#7D9D8A]\" data-kid=\"111\"></i> 25m</span>\n                    <span class=\"flex items-center gap-1\" data-kid=\"112\"><i class=\"ti ti-flame-filled text-amber-500\" data-kid=\"113\"></i> 450kcal</span>\n                  </div>\n                  <div class=\"w-6 h-6 rounded-full bg-zinc-50 flex items-center justify-center text-zinc-400 hover:bg-zinc-100 transition-colors cursor-pointer\" data-kid=\"114\">\n                    <i class=\"ti ti-dots text-sm\" data-kid=\"115\"></i>\n                  </div>\n                </div>\n              </div>\n            </div>\n\n            <div class=\"group h-20 rounded-3xl border-2 border-dashed border-zinc-100 bg-zinc-50/30 flex items-center gap-4 px-6 hover:bg-emerald-50/50 hover:border-[#7D9D8A]/20 transition-all cursor-pointer\" data-kid=\"116\">\n              <div class=\"w-9 h-9 rounded-full bg-white flex items-center justify-center text-[#7D9D8A] shadow-xs group-hover:bg-[#7D9D8A] group-hover:text-white transition-all\" data-kid=\"117\">\n                <i class=\"ti ti-plus text-lg\" data-kid=\"118\"></i>\n              </div>\n              <span class=\"text-xs font-bold text-zinc-400 group-hover:text-[#576b5d]\" data-kid=\"119\">Add Dinner</span>\n            </div>\n          </div>\n        </div>\n\n        \n        <div class=\"w-[320px] flex flex-col gap-6\" data-kid=\"120\">\n          <div class=\"relative py-6 px-1 mb-2\" data-kid=\"121\">\n            <span class=\"absolute top-0 right-0 text-[100px] font-black text-zinc-200/20 pointer-events-none select-none leading-none\" data-kid=\"122\">13</span>\n            <h3 class=\"relative text-2xl font-black text-zinc-900 tracking-tight\" data-kid=\"123\">Tuesday</h3>\n            <p class=\"relative text-[10px] font-black text-zinc-400 uppercase tracking-[0.2em]\" data-kid=\"124\">Balanced Day</p>\n          </div>\n\n          <div class=\"flex flex-col gap-5\" data-kid=\"125\">\n            <div class=\"group bg-white rounded-[32px] border border-zinc-100 shadow-sm overflow-hidden hover:shadow-xl hover:-translate-y-1 transition-all duration-300\" data-kid=\"126\">\n              <div class=\"h-44 relative\" data-kid=\"127\">\n                <img src=\"https://images.unsplash.com/photo-1687276287139-88f7333c8ca4?auto=format&w=600&q=80&fit=crop\" alt=\"Toast\" class=\"w-full h-full object-cover\" decoding=\"async\" loading=\"lazy\" data-kid=\"128\">\n                <div class=\"absolute inset-0 bg-gradient-to-b from-black/20 via-transparent to-transparent opacity-60\" data-kid=\"129\"></div>\n                <div class=\"absolute top-4 left-4 flex gap-2 z-10\" data-kid=\"130\">\n                   <span class=\"px-3 py-1 bg-white/95 backdrop-blur-md rounded-lg text-[10px] font-black text-[#7D9D8A] shadow-sm uppercase\" data-kid=\"131\">Breakfast</span>\n                </div>\n              </div>\n              <div class=\"p-6\" data-kid=\"132\">\n                <h4 class=\"text-md font-bold text-zinc-900 mb-3 group-hover:text-[#576b5d] transition-colors leading-snug\" data-kid=\"133\">Poached Egg Avocado Toast</h4>\n                <div class=\"flex items-center justify-between\" data-kid=\"134\">\n                  <div class=\"flex items-center gap-3 text-[11px] font-bold text-zinc-400\" data-kid=\"135\">\n                    <span class=\"flex items-center gap-1\" data-kid=\"136\"><i class=\"ti ti-clock-filled text-[#7D9D8A]\" data-kid=\"137\"></i> 15m</span>\n                    <span class=\"flex items-center gap-1\" data-kid=\"138\"><i class=\"ti ti-flame-filled text-amber-500\" data-kid=\"139\"></i> 320kcal</span>\n                  </div>\n                  <div class=\"w-6 h-6 rounded-full bg-zinc-50 flex items-center justify-center text-zinc-400 hover:bg-zinc-100 transition-colors cursor-pointer\" data-kid=\"140\">\n                    <i class=\"ti ti-dots text-sm\" data-kid=\"141\"></i>\n                  </div>\n                </div>\n              </div>\n            </div>\n\n            <div class=\"group h-20 rounded-3xl border-2 border-dashed border-zinc-100 bg-zinc-50/30 flex items-center gap-4 px-6 hover:bg-emerald-50/50 hover:border-[#7D9D8A]/20 transition-all cursor-pointer\" data-kid=\"142\">\n              <div class=\"w-9 h-9 rounded-full bg-white flex items-center justify-center text-[#7D9D8A] shadow-xs group-hover:bg-[#7D9D8A] group-hover:text-white transition-all\" data-kid=\"143\">\n                <i class=\"ti ti-plus text-lg\" data-kid=\"144\"></i>\n              </div>\n              <span class=\"text-xs font-bold text-zinc-400 group-hover:text-[#576b5d]\" data-kid=\"145\">Add Lunch</span>\n            </div>\n            \n            <div class=\"group h-20 rounded-3xl border-2 border-dashed border-zinc-100 bg-zinc-50/30 flex items-center gap-4 px-6 hover:bg-emerald-50/50 hover:border-[#7D9D8A]/20 transition-all cursor-pointer\" data-kid=\"146\">\n   