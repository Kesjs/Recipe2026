      "html": "\n<div class=\"flex flex-col min-h-screen bg-white font-sans text-[#18181b]\" data-kid=\"0\">\n  <style data-kid=\"1\">\n    @import url('https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=Roboto+Mono:wght@400;500&family=Inter:wght@400;500;600&display=swap');\n    @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n    .font-serif { font-family: 'DM Serif Display', serif; }\n    .font-mono { font-family: 'Roboto Mono', monospace; }\n    .font-sans { font-family: 'Inter', sans-serif; }\n\n    .no-scrollbar::-webkit-scrollbar { display: none; }\n    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }\n\n    /* Custom underline animation for active category */\n    .active-category::after {\n      content: '';\n      position: absolute;\n      bottom: -12px;\n      left: 0;\n      width: 100%;\n      height: 6px;\n      background-color: #445247;\n    }\n  </style>\n\n  \n  <header class=\"h-24 flex items-center justify-between px-8 md:px-16 bg-white z-50\" data-kid=\"2\">\n    <div class=\"flex items-center gap-3 cursor-pointer group\" data-kid=\"3\">\n      <div class=\"w-10 h-10 bg-[#445247] flex items-center justify-center transition-transform group-hover:rotate-12\" data-kid=\"4\">\n        <span class=\"text-white font-serif text-2xl\" data-kid=\"5\">N</span>\n      </div>\n      <span class=\"font-serif text-3xl tracking-tighter\" data-kid=\"6\">Naya</span>\n    </div>\n    <nav class=\"hidden md:flex items-center gap-12 font-mono text-xs uppercase tracking-widest text-zinc-400\" data-kid=\"7\">\n      <a href=\"#\" class=\"text-[#18181b] hover:text-[#445247] transition-colors\" data-kid=\"8\">Recipes</a>\n      <a href=\"#\" class=\"hover:text-[#18181b] transition-colors\" data-kid=\"9\">Ingredients</a>\n      <a href=\"#\" class=\"hover:text-[#18181b] transition-colors\" data-kid=\"10\">Journal</a>\n      <a href=\"#\" class=\"hover:text-[#18181b] transition-colors\" data-kid=\"11\">Search <i class=\"ti ti-search ml-1\" data-kid=\"12\"></i></a>\n    </nav>\n    <div class=\"flex items-center gap-6\" data-kid=\"13\">\n      <button class=\"font-mono text-xs uppercase tracking-widest border border-zinc-200 px-6 py-2 hover:border-[#445247] transition-colors\" data-kid=\"14\">Sign In</button>\n    </div>\n  </header>\n\n  <main class=\"flex-grow\" data-kid=\"15\">\n    \n    <section class=\"min-h-[800px] flex flex-col md:flex-row overflow-hidden border-b border-zinc-100\" data-kid=\"16\">\n      <div class=\"w-full md:w-1/2 p-12 md:p-24 lg:p-32 flex flex-col justify-center bg-white\" data-kid=\"17\">\n        <span class=\"font-mono text-[10px] md:text-xs tracking-[0.3em] text-zinc-400 mb-8 uppercase\" data-kid=\"18\">Featured Recipe</span>\n        <h1 class=\"font-serif text-7xl md:text-8xl lg:text-[10rem] text-[#18181b] leading-[0.8] mb-12 tracking-tighter\" data-kid=\"19\">\n          Poached<br data-kid=\"20\">Perfection\n        </h1>\n        <p class=\"text-zinc-500 text-lg md:text-xl max-w-sm mb-16 leading-relaxed\" data-kid=\"21\">\n          Master the art of the perfect yolk. A Scandinavian approach to the quintessential breakfast staple.\n        </p>\n        <div class=\"flex flex-wrap items-center gap-10\" data-kid=\"22\">\n          <button class=\"bg-[#445247] text-white px-12 py-6 font-medium tracking-tight hover:bg-[#313a31] transition-all transform hover:-translate-y-1 shadow-sm\" data-kid=\"23\">\n            Cook Now\n          </button>\n          <a href=\"#\" class=\"font-medium text-[#18181b] border-b-2 border-[#18181b] pb-2 hover:text-zinc-500 hover:border-zinc-200 transition-all flex items-center gap-2\" data-kid=\"24\">\n            Read the story <i class=\"ti ti-arrow-up-right\" data-kid=\"25\"></i>\n          </a>\n        </div>\n      </div>\n      <div class=\"w-full md:w-1/2 relative bg-zinc-50\" data-kid=\"26\">\n        <img src=\"https://images.unsplash.com/photo-1744893811003-7e6bffd2ec8d?auto=format&w=1600&q=80&fit=crop\" alt=\"Macro Poached Egg on Toast\" class=\"w-full h-full object-cover grayscale-[0.1] contrast-[1.05]\" decoding=\"async\" loading=\"lazy\" data-kid=\"27\">\n        \n        <div class=\"absolute bottom-12 right-12 bg-white p-6 md:p-8 shadow-2xl flex flex-col items-center border border-zinc-100\" data-kid=\"28\">\n          <span class=\"font-mono text-[10px] text-zinc-400 uppercase tracking-widest mb-2 border-b border-zinc-100 pb-2 w-full text-center\" data-kid=\"29\">Preparation</span>\n          <span class=\"font-serif text-3xl text-[#18181b]\" data-kid=\"30\">12 min</span>\n        </div>\n      </div>\n    </section>\n\n    \n    <section class=\"py-12 px-8 md:px-16 border-b border-zinc-100\" data-kid=\"31\">\n      <div class=\"max-w-7xl mx-auto flex items-end justify-between overflow-x-auto no-scrollbar pb-4\" data-kid=\"32\">\n        <div class=\"flex gap-16 md:gap-24\" data-kid=\"33\">\n          <div class=\"relative active-category cursor-pointer\" data-kid=\"34\">\n            <span class=\"text-3xl md:text-5xl font-serif text-[#18181b] font-bold\" data-kid=\"35\">Breakfast</span>\n          </div>\n          <div class=\"relative cursor-pointer group\" data-kid=\"36\">\n            <span class=\"text-3xl md:text-5xl font-serif text-zinc-300 group-hover:text-[#18181b] transition-all duration-500\" data-kid=\"37\">Lunch</span>\n            <div class=\"absolute -bottom-3 left-0 w-0 h-[6px] bg-[#445247] group-hover:w-full transition-all duration-500\" data-kid=\"38\"></div>\n          </div>\n          <div class=\"relative cursor-pointer group\" data-kid=\"39\">\n            <span class=\"text-3xl md:text-5xl font-serif text-zinc-300 group-hover:text-[#18181b] transition-all duration-500\" data-kid=\"40\">Dinner</span>\n            <div class=\"absolute -bottom-3 left-0 w-0 h-[6px] bg-[#445247] group-hover:w-full transition-all duration-500\" data-kid=\"41\"></div>\n          </div>\n          <div class=\"relative cursor-pointer group\" data-kid=\"42\">\n            <span class=\"text-3xl md:text-5xl font-serif text-zinc-300 group-hover:text-[#18181b] transition-all duration-500\" data-kid=\"43\">Dessert</span>\n            <div class=\"absolute -bottom-3 left-0 w-0 h-[6px] bg-[#445247] group-hover:w-full transition-all duration-500\" data-kid=\"44\"></div>\n          </div>\n          <div class=\"relative cursor-pointer group\" data-kid=\"45\">\n            <span class=\"text-3xl md:text-5xl font-serif text-zinc-300 group-hover:text-[#18181b] transition-all duration-500\" data-kid=\"46\">Snacks</span>\n            <div class=\"absolute -bottom-3 left-0 w-0 h-[6px] bg-[#445247] group-hover:w-full transition-all duration-500\" data-kid=\"47\"></div>\n          </div>\n        </div>\n        <button class=\"p-3 text-zinc-300 hover:text-[#18181b] transition-colors ml-12\" data-kid=\"48\">\n          <i class=\"ti ti-adjustments-horizontal text-3xl\" data-kid=\"49\"></i>\n        </button>\n      </div>\n    </section>\n\n    \n    <section class=\"py-24 px-8 md:px-16 max-w-7xl mx-auto\" data-kid=\"50\">\n      <div class=\"space-y-32\" data-kid=\"51\">\n        \n        \n        <div class=\"flex flex-col lg:flex-row bg-[#f5f8f6] group cursor-pointer overflow-hidden min-h-[550px]\" data-kid=\"52\">\n          <div class=\"w-full lg:w-[60%] h-[450px] lg:h-auto overflow-hidden\" data-kid=\"53\">\n            <img src=\"https://images.unsplash.com/photo-1588166524941-3bf61a9c41db?auto=format&w=1400&q=80&fit=crop\" alt=\"Turmeric & Ginger Curry Bowl\" class=\"w-full h-full object-cover group-hover:scale-110 transition-transform duration-[2000ms]\" decoding=\"async\" loading=\"lazy\" data-kid=\"54\">\n          </div>\n          <div class=\"w-full lg:w-[40%] p-12 lg:p-20 flex flex-col justify-center\" data-kid=\"55\">\n            <span class=\"font-mono text-xs text-[#445247] mb-6 uppercase tracking-widest\" data-kid=\"56\">Featured Dish</span>\n            <h3 class=\"font-serif text-5xl text-[#18181b] mb-8 leading-tight\" data-kid=\"57\">Turmeric & Ginger Curry Bowl</h3>\n            <p class=\"text-zinc-500 text-lg mb-10 leading-relaxed\" data-kid=\"58\">\n              A balanced blend of earthy turmeric and sharp ginger, served over steamed jasmine rice. Vegan and soul-warming.\n            </p>\n            <div class=\"flex items-center gap-6 text-xs font-mono text-zinc-400\" data-kid=\"59\">\n              <span class=\"flex items-center gap-2\" data-kid=\"60\"><i class=\"ti ti-clock\" data-kid=\"61\"></i> 35 MIN</span>\n              <span class=\"flex items-center gap-2\" data-kid=\"62\"><i class=\"ti ti-flame\" data-kid=\"63\"></i> 520 KCAL</span>\n              <span class=\"flex items-center gap-2\" data-kid=\"64\"><i class=\"ti ti-chef-hat\" data-kid=\"65\"></i> EASY</span>\n            </div>\n          </div>\n        </div>\n\n        \n        <div class=\"grid grid-cols-1 md:grid-cols-2 gap-x-24 gap-y-8\" data-kid=\"66\">\n          \n          \n          <div class=\"flex items-center gap-8 border-b border-zinc-100 pb-8 group cursor-pointer hover:border-[#445247] transition-all\" data-kid=\"67\">\n            <div class=\"w-32 h-32 shrink-0 bg-zinc-50 overflow-hidden\" data-kid=\"68\">\n              <img src=\"https://images.unsplash.com/photo-1490474418585-ba9bad8fd0ea?auto=format&w=600&q=80&fit=crop\" alt=\"Smoothie Bowl\" class=\"w-full h-full object-cover group-hover:scale-110 transition-transform duration-700\" decoding=\"async\" loading=\"lazy\" data-kid=\"69\">\n            </div>\n            <div class=\"flex-grow\" data-kid=\"70\">\n              <h4 class=\"text-2xl font-serif text-[#18181b] mb-3 group-hover:text-[#445247] transition-colors\" data-kid=\"71\">Summer Berry Acai Bowl</h4>\n              <div class=\"flex items-center gap-4 font-mono text-[10px] text-zinc-400 uppercase tracking-[0.15em]\" data-kid=\"72\">\n                <span data-kid=\"73\">Breakfast</span>\n                <span data-kid=\"74\">•</span>\n                <span data-kid=\"75\">15 Min</span>\n                <span data-kid=\"76\">•</span>\n                <span data-kid=\"77\">280 Kcal</span>\n              </div>\n            </div>\n            <i class=\"ti ti-arrow-right text-zinc-200 group-hover:text-[#445247] transition-colors text-2xl\" data-kid=\"78\"></i>\n          </div>\n\n          \n          <div class=\"flex items-center gap-8 border-b border-zinc-100 pb-8 group cursor-pointer hover:border-[#445247] transition-all\" data-kid=\"79\">\n            <div class=\"w-32 h-32 shrink-0 bg-zinc-50 overflow-hidden\" data-kid=\"80\">\n              <img src=\"https://images.unsplash.com/photo-1690949237809-3f0336b9ba33?auto=format&w=600&q=80&fit=crop\" alt=\"Salt and Pepper Tofu\" class=\"w-full h-full object-cover group-hover:scale-110 transition-transform duration-700\" decoding=\"async\" loading=\"lazy\" data-kid=\"81\">\n            </div>\n            <div class=\"flex-grow\" data-kid=\"82\">\n              <h4 class=\"text-2xl font-serif text-[#18181b] mb-3 group-hover:text-[#445247] transition-colors\" data-kid=\"83\">Crispy Salt & Pepper Tofu</h4>\n              <div class=\"flex items-center gap-4 font-mono text-[10px] text-zinc-400 uppercase tracking-[0.15em]\" data-kid=\"84\">\n                <span data-kid=\"85\">Lunch</span>\n                <span data-kid=\"86\">•</span>\n                <span data-kid=\"87\">25 Min</span>\n                <span data-kid=\"88\">•</span>\n                <span data-kid=\"89\">310 Kcal</span>\n              </div>\n            </div>\n            <i class=\"ti ti-arrow-right text-zinc-200 group-hover:text-[#445247] transition-colors text-2xl\" data-kid=\"90\"></i>\n          </div>\n\n          \n          <div class=\"flex items-center gap-8 border-b border-zinc-100 pb-8 group cursor-pointer hover:border-[#445247] transition-all\" data-kid=\"91\">\n            <div class=\"w-32 h-32 shrink-0 bg-zinc-50 overflow-hidden\" data-kid=\"92\">\n              <img src=\"https://images.unsplash.com/photo-1546069901-ba9599a7e63c?auto=format&w=600&q=80&fit=crop\" alt=\"Quinoa Salad\" class=\"w-full h-full object-cover group-hover:scale-110 transition-transform duration-700\" decoding=\"async\" loading=\"lazy\" data-kid=\"93\">\n            </div>\n            <div class=\"flex-grow\" data-kid=\"94\">\n              <h4 class=\"text-2xl font-serif text-[#18181b] mb-3 group-hover:text-[#445247] transition-colors\" data-kid=\"95\">Avocado & Quinoa Power Salad</h4>\n              <div class=\"flex items-center gap-4 font-mono text-[10px] text-zinc-400 uppercase tracking-[0.15em]\" data-kid=\"96\">\n                <span data-kid=\"97\">Lunch</span>\n                <span data-kid=\"98\">•</span>\n                <span data-kid=\"99\">20 Min</span>\n                <span data-kid=\"100\">•</span>\n                <span data-kid=\"101\">450 Kcal</span>\n              </div>\n            </div>\n            <i class=\"ti ti-arrow-right text-zinc-200 group-hover:text-[#445247] transition-colors text-2xl\" data-kid=\"102\"></i>\n          </div>\n\n          \n          <div class=\"flex items-center gap-8 border-b border-zinc-100 pb-8 group cursor-pointer hover:border-[#445247] transition-all\" data-kid=\"103\">\n            <div class=\"w-32 h-32 shrink-0 bg-zinc-50 overflow-hidden\" data-kid=\"104\">\n              <img src=\"https://images.unsplash.com/photo-1547592166-23ac45744acd?auto=format&w=600&q=80&fit=crop\" alt=\"Rosemary Chicken\" class=\"w-full h-full object-cover group-hover:scale-110 transition-transform duration-700\" decoding=\"async\" loading=\"lazy\" data-kid=\"105\">\n            </div>\n            <div class=\"flex-grow\" data-kid=\"106\">\n              <h4 class=\"text-2xl font-serif text-[#18181b] mb-3 group-hover:text-[#445247] transition-colors\" data-kid=\"107\">Herb Roasted Chicken Thighs</h4>\n              <div class=\"flex items-center gap-4 font-mono text-[10px] text-zinc-400 uppercase tracking-[0.15em]\" data-kid=\"108\">\n                <span data-kid=\"109\">Dinner</span>\n                <span data-kid=\"110\">•</span>\n                <span data-kid=\"111\">45 Min</span>\n                <span data-kid=\"112\">•</span>\n                <span data-kid=\"113\">580 Kcal</span>\n              </div>\n            </div>\n            <i class=\"ti ti-arrow-right text-zinc-200 group-hover:text-[#445247] transition-colors text-2xl\" data-kid=\"114\"></i>\n          </div>\n\n        </div>\n\n        \n        <div class=\"flex justify-center pt-16\" data-kid=\"115\">\n          <button class=\"font-mono text-[10px] md:text-xs uppercase tracking-[0.4em] text-[#18181b] border-b-2 border-[#18181b] pb-3 hover:text-zinc-400 hover:border-zinc-100 transition-all cursor-pointer\" data-kid=\"116\">\n            Explore Collection\n          </button>\n        </div>\n      </div>\n    </section>\n\n    \n    <section class=\"py-32 bg-zinc-50 px-8 md:px-16\" data-kid=\"117\">\n      <div class=\"max-w-3xl mx-auto text-center\" data-kid=\"118\">\n        <h2 class=\"font-serif text-5xl text-[#18181b] mb-8 tracking-tight\" data-kid=\"119\">The Weekly Digest</h2>\n        <p class=\"text-zinc-500 text-lg mb-12 leading-relaxed\" data-kid=\"120\">\n          Curated seasonal recipes, nutritional insights, and culinary stories delivered to your inbox every Sunday morning.\n        </p>\n        <form class=\"flex flex-col sm:flex-row gap-0 border-2 border-[#18181b] bg-white group focus-within:ring-4 focus-within:ring-[#445247]/10 transition-all\" data-kid=\"121\">\n          <input type=\"email\" placeholder=\"Your email address\" class=\"flex-grow px-8 py-6 outline-none font-sans placeholder:text-zinc-300\" data-kid=\"122\">\n          <button class=\"bg-[#18181b] text-white px-12 py-6 font-mono text-xs uppercase tracking-widest hover:bg-[#445247] transition-colors\" data-kid=\"123\">Subscribe</button>\n        </form>\n      </div>\n    </section>\n  </main>\n\n  \n  <footer class=\"bg-white px-8 md:px-16 py-24 border-t border-zinc-100\" data-kid=\"124\">\n    <div class=\"max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-4 gap-16 md:gap-8\" data-kid=\"125\">\n      <div class=\"col-span-1 md:col-span-1\" data-kid=\"126\">\n        <div class=\"flex items-center gap-2 mb-8\" data-kid=\"127\">\n          <div class=\"w-6 h-6 bg-[#445247] flex items-center justify-center\" data-kid=\"128\">\n            <span class=\"text-white font-serif text-sm\" data-kid=\"129\">N</span>\n          </div>\n          <span class=\"font-serif text-xl\" data-kid=\"130\">Naya</span>\n        </div>\n        <p class=\"text-zinc-400 text-sm leading-relaxed max-w-xs\" data-kid=\"131\">\n          A Nordic philosophy applied to the global kitchen. Minimalism in form, maximalism in flavor.\n        </p>\n      </div>\n      \n      <div data-kid=\"132\">\n        <h5 class=\"font-mono text-[10px] uppercase tracking-widest text-zinc-900 mb-8\" data-kid=\"133\">Navigation</h5>\n        <ul class=\"space-y-4 text-sm text-zinc-400\" data-kid=\"134\">\n          <li data-kid=\"135\"><a href=\"#\" class=\"hover:text-[#18181b] transition-colors\" data-kid=\"136\">Browse Recipes</a></li>\n          <li data-kid=\"137\"><a href=\"#\" class=\"hover:text-[#18181b] transition-colors\" data-kid=\"138\">Meal Planning</a></li>\n          <li data-kid=\"139\"><a href=\"#\" class=\"hover:text-[#18181b] transition-colors\" data-kid=\"140\">Nutrition Guide</a></li>\n          <li data-kid=\"141\"><a href=\"#\" class=\"hover:text-[#18181b] transition-colors\" data-kid=\"142\">Ingredients</a></li>\n        </ul>\n      </div>\n\n      <div data-kid=\"143\">\n        <h5 class=\"font-mono text-[10px] uppercase tracking-widest text-zinc-900 mb-8\" data-kid=\"144\">Company</h5>\n        <ul class=\"space-y-4 text-sm text-zinc-400\" data-kid=\"145\">\n          <li data-kid=\"146\"><a href=\"#\" class=\"hover:text-[#18181b] transition-colors\" data-kid=\"147\">Our Story</a></li>\n          <li data-kid=\"148\"><a href=\"#\" class=\"hover:text-[#18181b] transition-colors\" data-kid=\"149\">Kitchen Blog</a></li>\n          <li data-kid=\"150\"><a href=\"#\" class=\"hover:text-[#18181b] transition-colors\" data-kid=\"151\">Contact</a></li>\n          <li data-kid=\"152\"><a href=\"#\" class=\"hover:text-[#18181b] transition-colors\" data-kid=\"153\">Privacy</a></li>\n        </ul>\n      </div>\n\n      <div data-kid=\"154\">\n        <h5 class=\"font-mono text-[10px] uppercase tracking-widest text-zinc-900 mb-8\" data-kid=\"155\">Social</h5>\n        <div class=\"flex gap-8\" data-kid=\"156\">\n          <a href=\"#\" class=\"text-zinc-300 hover:text-[#18181b] transition-colors text-2xl\" data-kid=\"157\"><i class=\"ti ti-brand-instagram\" data-kid=\"158\"></i></a>\n          <a href=\"#\" class=\"text-zinc-300 hover:text-[#18181b] transition-colors text-2xl\" data-kid=\"159\"><i class=\"ti ti-brand-pinterest\" data-kid=\"160\"></i></a>\n          <a href=\"#\" class=\"text-zinc-300 hover:text-[#18181b] transition-colors text-2xl\" data-kid=\"161\"><i class=\"ti ti-brand-twitter\" data-kid=\"162\"></i></a>\n        </div>\n      </div>\n    </div>\n    \n    <div class=\"max-w-7xl mx-auto mt-24 pt-12 border-t border-zinc-100 flex flex-col md:flex-row justify-between items-center gap-8\" data-kid=\"163\">\n      <span class=\"font-mono text-[11px] text-zinc-500 uppercase tracking-widest\" data-kid=\"164\">© 2024 Naya Culinary Lab. All rights reserved.</span>\n      <div class=\"flex gap-12 font-mono text-[11px] text-zinc-500 uppercase tracking-widest\" data-kid=\"165\">\n        <a href=\"#\" class=\"hover:text-[#18181b] transition-colors\" data-kid=\"166\">Terms</a>\n        <a href=\"#\" class=\"hover:text-[#18181b] transition-colors\" data-kid=\"167\">Cookies</a>\n      </div>\n    </div>\n  </footer>\n</div>\n",
