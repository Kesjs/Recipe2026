      "html": "\n<div class=\"relative min-h-[900px] w-full font-sans selection:bg-emerald-100 selection:text-emerald-900 bg-zinc-950 overflow-hidden\" data-kid=\"0\">\n  <style data-kid=\"1\">\n    @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Inter:wght@300;400;500;600;700&display=swap');\n    @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n    .font-serif { font-family: 'Playfair Display', serif; }\n    .font-sans { font-family: 'Inter', sans-serif; }\n\n    .glass-nav {\n      backdrop-filter: blur(16px);\n      -webkit-backdrop-filter: blur(16px);\n      background: rgba(255, 255, 255, 0.08);\n      border: 1px solid rgba(255, 255, 255, 0.1);\n    }\n\n    .glass-card {\n      backdrop-filter: blur(24px);\n      -webkit-backdrop-filter: blur(24px);\n      background: rgba(255, 255, 255, 0.6);\n      border: 1px solid rgba(255, 255, 255, 0.4);\n    }\n\n    .bg-immersive {\n      background-image: url('https://images.unsplash.com/photo-1744104135578-6768f2061be1?auto=format&w=1600&q=80&fit=crop');\n      background-size: cover;\n      background-position: center;\n    }\n\n    /* Floating label animations */\n    .floating-label-group input:focus ~ label,\n    .floating-label-group input:not(:placeholder-shown) ~ label {\n      transform: translateY(-2.4rem) scale(0.75);\n      color: #059669; /* emerald-600 */\n      font-weight: 700;\n    }\n\n    .floating-label-group label {\n      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);\n      transform-origin: left top;\n    }\n\n    .glass-nav-item {\n      position: relative;\n    }\n    .glass-nav-item::after {\n      content: '';\n      position: absolute;\n      bottom: -4px;\n      left: 0;\n      width: 0;\n      height: 2px;\n      background: white;\n      transition: width 0.3s ease;\n    }\n    .glass-nav-item:hover::after {\n      width: 100%;\n    }\n  </style>\n\n  \n  <div class=\"absolute inset-0 bg-immersive\" data-kid=\"2\">\n    <div class=\"absolute inset-0 bg-zinc-950/40 mix-blend-multiply\" data-kid=\"3\"></div>\n    <div class=\"absolute inset-0 bg-gradient-to-t from-zinc-950/60 via-transparent to-zinc-950/20\" data-kid=\"4\"></div>\n  </div>\n\n  \n  <nav class=\"absolute top-0 left-0 w-full z-50 px-8 py-8\" data-kid=\"5\">\n    <div class=\"max-w-7xl mx-auto flex items-center justify-between glass-nav rounded-[2.5rem] px-10 py-4 shadow-2xl\" data-kid=\"6\">\n      <div class=\"flex items-center space-x-2 group cursor-pointer\" data-kid=\"7\">\n        <div class=\"w-10 h-10 bg-emerald-600 rounded-xl flex items-center justify-center text-white shadow-lg group-hover:rotate-6 transition-transform\" data-kid=\"8\">\n          <i class=\"ti ti-leaf text-2xl\" data-kid=\"9\"></i>\n        </div>\n        <span class=\"font-bold text-2xl tracking-tighter text-white\" data-kid=\"10\">Naya</span>\n      </div>\n\n      <div class=\"hidden md:flex items-center space-x-12\" data-kid=\"11\">\n        <a href=\"#\" class=\"glass-nav-item text-sm font-bold text-white tracking-wide\" data-kid=\"12\">Recettes</a>\n        <a href=\"#\" class=\"glass-nav-item text-sm font-bold text-white/90 hover:text-white transition-colors tracking-wide\" data-kid=\"13\">Nutrition</a>\n        <a href=\"#\" class=\"glass-nav-item text-sm font-bold text-white/90 hover:text-white transition-colors tracking-wide\" data-kid=\"14\">Actualités</a>\n        <a href=\"#\" class=\"glass-nav-item text-sm font-bold text-white/90 hover:text-white transition-colors tracking-wide\" data-kid=\"15\">À Propos</a>\n      </div>\n\n      <div class=\"flex items-center space-x-5\" data-kid=\"16\">\n        <button class=\"p-2.5 rounded-full hover:bg-white/10 text-white transition-colors\" data-kid=\"17\">\n          <i class=\"ti ti-search text-xl\" data-kid=\"18\"></i>\n        </button>\n        <button class=\"hidden sm:flex items-center space-x-2 px-7 py-2.5 bg-white text-zinc-900 rounded-full text-sm font-bold hover:bg-emerald-50 transition-all shadow-xl active:scale-95\" data-kid=\"19\">\n          <span data-kid=\"20\">S'abonner</span>\n        </button>\n      </div>\n    </div>\n  </nav>\n\n  \n  <main class=\"relative z-10 flex min-h-[900px] items-center justify-center px-6 py-24\" data-kid=\"21\">\n    <div class=\"glass-card w-full max-w-xl p-12 md:p-16 rounded-[3rem] shadow-[0_48px_100px_-20px_rgba(0,0,0,0.3)] animate-in fade-in zoom-in duration-700\" data-kid=\"22\">\n      <div class=\"flex flex-col items-center text-center mb-12\" data-kid=\"23\">\n        <span class=\"px-5 py-1.5 bg-emerald-100/60 text-emerald-800 text-[9px] font-bold tracking-[0.4em] uppercase rounded-full mb-8 shadow-xs border border-emerald-200/30\" data-kid=\"24\">Membres Uniquement</span>\n        <h1 class=\"font-serif text-6xl md:text-[5.5rem] text-zinc-900 leading-[1] mb-6 tracking-tight\" data-kid=\"25\">\n          Bienvenue <span class=\"italic font-normal block mt-1 text-emerald-900\" data-kid=\"26\">chez Naya</span>\n        </h1>\n        <p class=\"text-zinc-600/90 text-lg md:text-xl max-w-sm leading-relaxed font-medium\" data-kid=\"27\">\n          Rejoignez notre communauté et savourez le meilleur de la cuisine locale.\n        </p>\n      </div>\n\n      <form class=\"space-y-12\" data-kid=\"28\">\n        <div class=\"floating-label-group relative group\" data-kid=\"29\">\n          <input type=\"email\" id=\"email\" placeholder=\" \" class=\"peer w-full bg-transparent border-b-2 border-zinc-400/30 py-4.5 text-xl text-zinc-900 focus:outline-none focus:border-emerald-600 transition-colors\" required data-kid=\"30\">\n          <label for=\"email\" class=\"absolute left-0 top-4.5 text-zinc-500 text-lg pointer-events-none\" data-kid=\"31\">Adresse e-mail</label>\n          <div class=\"absolute right-0 top-1/2 -translate-y-1/2 text-zinc-400 group-focus-within:text-emerald-600 transition-all transform group-focus-within:scale-110\" data-kid=\"32\">\n            <i class=\"ti ti-mail text-xl\" data-kid=\"33\"></i>\n          </div>\n        </div>\n\n        <div class=\"floating-label-group relative group\" data-kid=\"34\">\n          <input type=\"password\" id=\"password\" placeholder=\" \" class=\"peer w-full bg-transparent border-b-2 border-zinc-400/30 py-4.5 text-xl text-zinc-900 focus:outline-none focus:border-emerald-600 transition-colors\" required data-kid=\"35\">\n          <label for=\"password\" class=\"absolute left-0 top-4.5 text-zinc-500 text-lg pointer-events-none\" data-kid=\"36\">Mot de passe</label>\n          <div class=\"absolute right-0 top-1/2 -translate-y-1/2 flex space-x-4 items-center\" data-kid=\"37\">\n            <button type=\"button\" class=\"text-zinc-400 hover:text-zinc-600 transition-colors\" data-kid=\"38\">\n              <i class=\"ti ti-eye text-xl\" data-kid=\"39\"></i>\n            </button>\n            <i class=\"ti ti-lock text-xl text-zinc-400 group-focus-within:text-emerald-600 transition-all transform group-focus-within:scale-110\" data-kid=\"40\"></i>\n          </div>\n        </div>\n\n        <div class=\"flex items-center justify-between pt-2\" data-kid=\"41\">\n          <label class=\"flex items-center space-x-3 cursor-pointer group\" data-kid=\"42\">\n            <div class=\"relative w-6 h-6\" data-kid=\"43\">\n              <input type=\"checkbox\" class=\"peer hidden\" data-kid=\"44\">\n              <div class=\"absolute inset-0 bg-white/50 border-2 border-zinc-300 rounded-lg transition-all peer-checked:bg-emerald-600 peer-checked:border-emerald-600 shadow-xs\" data-kid=\"45\"></div>\n              <i class=\"ti ti-check absolute inset-0 text-white text-base flex items-center justify-center opacity-0 peer-checked:opacity-100 transition-opacity\" data-kid=\"46\"></i>\n            </div>\n            <span class=\"text-sm font-semibold text-zinc-600 group-hover:text-zinc-900 transition-colors\" data-kid=\"47\">Se souvenir de moi</span>\n          </label>\n          <a href=\"#\" class=\"text-sm font-bold text-zinc-600 hover:text-emerald-700 transition-colors border-b border-zinc-300 hover:border-emerald-600 pb-0.5\" data-kid=\"48\">Mot de passe oublié ?</a>\n        </div>\n\n        <button type=\"submit\" class=\"w-full py-6 bg-zinc-950 text-white rounded-[2rem] font-bold text-xl hover:bg-emerald-800 transition-all shadow-[0_20px_40px_-10px_rgba(0,0,0,0.4)] hover:shadow-emerald-900/10 active:scale-95 flex items-center justify-center space-x-3 group relative overflow-hidden tracking-wide\" data-kid=\"49\">\n          <div class=\"absolute inset-0 bg-white/5 translate-y-full group-hover:translate-y-0 transition-transform duration-300\" data-kid=\"50\"></div>\n          <span class=\"relative z-10\" data-kid=\"51\">Se Connecter</span>\n          <i class=\"ti ti-arrow-right relative z-10 group-hover:translate-x-1 transition-transform\" data-kid=\"52\"></i>\n        </button>\n      </form>\n\n      <div class=\"mt-14 text-center\" data-kid=\"53\">\n        <p class=\"text-zinc-500 text-lg\" data-kid=\"54\">\n          Pas encore de compte ? \n          <a href=\"#\" class=\"text-zinc-900 font-bold underline decoration-emerald-500/30 underline-offset-8 hover:decoration-emerald-500 transition-all ml-1\" data-kid=\"55\">\n            Créer un compte\n          </a>\n        </p>\n      </div>\n    </div>\n  </main>\n\n  \n  <div class=\"absolute bottom-8 left-0 w-full px-12 hidden xl:flex justify-between items-end pointer-events-none\" data-kid=\"56\">\n    <div class=\"max-w-xs space-y-4 pointer-events-auto\" data-kid=\"57\">\n      <p class=\"text-white/70 text-sm leading-relaxed font-medium\" data-kid=\"58\">\n        Découvrez des milliers de recettes saines et équilibrées, conçues par nos experts pour votre bien-être.\n      </p>\n      <div class=\"flex items-center space-x-4\" data-kid=\"59\">\n        <div class=\"flex -space-x-2\" data-kid=\"60\">\n          <img src=\"https://i.pravatar.cc/100?u=sarah\" class=\"w-9 h-9 rounded-full border border-emerald-500 shadow-lg\" alt=\"User\" decoding=\"async\" loading=\"lazy\" data-kid=\"61\">\n          <img src=\"https://i.pravatar.cc/100?u=marc\" class=\"w-9 h-9 rounded-full border border-emerald-500 shadow-lg\" alt=\"User\" decoding=\"async\" loading=\"lazy\" data-kid=\"62\">\n          <img src=\"https://i.pravatar.cc/100?u=leila\" class=\"w-9 h-9 rounded-full border border-emerald-500 shadow-lg\" alt=\"User\" decoding=\"async\" loading=\"lazy\" data-kid=\"63\">\n        </div>\n        <div class=\"flex flex-col\" data-kid=\"64\">\n          <span class=\"text-white font-bold text-xs\" data-kid=\"65\">+2,4k membres</span>\n          <span class=\"text-emerald-400 text-[8px] font-bold uppercase tracking-widest\" data-kid=\"66\">Actifs</span>\n        </div>\n      </div>\n    </div>\n    \n    <div class=\"flex items-center space-x-8 text-white/40 text-[10px] font-bold uppercase tracking-widest pointer-events-auto\" data-kid=\"67\">\n      <a href=\"#\" class=\"hover:text-emerald-400 transition-colors\" data-kid=\"68\">Conditions</a>\n      <a href=\"#\" class=\"hover:text-emerald-400 transition-colors\" data-kid=\"69\">Confidentialité</a>\n      <a href=\"#\" class=\"hover:text-emerald-400 transition-colors\" data-kid=\"70\">Aide</a>\n    </div>\n  </div>\n</div>\n",
