      "html": "\n<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  .font-sans {\n    font-family: 'Inter', sans-serif;\n  }\n\n  @keyframes pulse-glow {\n    0%, 100% {\n      opacity: 0.5;\n      transform: scale(1);\n      box-shadow: 0 0 20px 5px rgba(245, 158, 11, 0.4);\n    }\n    50% {\n      opacity: 1;\n      transform: scale(1.05);\n      box-shadow: 0 0 35px 10px rgba(245, 158, 11, 0.6);\n    }\n  }\n\n  .glow-mic {\n    animation: pulse-glow 3s infinite ease-in-out;\n  }\n\n  .progress-fill {\n    width: 37.5%; /* 3 of 8 */\n  }\n\n  /* Custom hide scrollbar */\n  .no-scrollbar::-webkit-scrollbar {\n    display: none;\n  }\n  .no-scrollbar {\n    -ms-overflow-style: none;\n    scrollbar-width: none;\n  }\n</style>\n\n<div class=\"w-full h-[900px] bg-zinc-900 text-zinc-50 font-sans flex flex-col relative overflow-hidden select-none\" data-kid=\"1\">\n  \n  <div class=\"absolute top-0 left-0 w-full h-1.5 bg-zinc-800 z-50\" data-kid=\"2\">\n    <div class=\"h-full bg-emerald-500 progress-fill transition-all duration-1000 shadow-[0_0_10px_rgba(16,185,129,0.5)]\" data-kid=\"3\"></div>\n  </div>\n\n  \n  <header class=\"pt-10 pb-4 px-12 flex justify-between items-center bg-gradient-to-b from-zinc-900 to-transparent\" data-kid=\"4\">\n    <div class=\"flex flex-col\" data-kid=\"5\">\n      <span class=\"text-zinc-600 text-[10px] font-black uppercase tracking-[0.4em] mb-1\" data-kid=\"6\">Recipe: Pan-Seared Salmon</span>\n      <div class=\"flex items-center gap-3\" data-kid=\"7\">\n        <span class=\"text-zinc-100 text-lg font-black tracking-widest uppercase\" data-kid=\"8\">Step 3 of 8</span>\n        <span class=\"w-1 h-1 rounded-full bg-emerald-500/50 shadow-[0_0_5px_rgba(16,185,129,0.5)]\" data-kid=\"9\"></span>\n        <span class=\"text-zinc-500 text-xs font-semibold uppercase tracking-wider\" data-kid=\"10\">Preparation</span>\n      </div>\n    </div>\n\n    \n    <div class=\"flex items-center gap-5\" data-kid=\"11\">\n      <div class=\"text-right hidden sm:block\" data-kid=\"12\">\n        <span class=\"block text-amber-500 text-[10px] font-black uppercase tracking-widest leading-none\" data-kid=\"13\">Voice Active</span>\n        <span class=\"block text-zinc-500 text-[9px] uppercase tracking-tighter\" data-kid=\"14\">\"Next\" | \"Repeat\" | \"Go Back\"</span>\n      </div>\n      <div class=\"relative group\" data-kid=\"15\">\n        <div class=\"absolute inset-0 bg-amber-500/20 blur-xl rounded-full glow-mic\" data-kid=\"16\"></div>\n        <div class=\"relative w-12 h-12 flex items-center justify-center bg-zinc-900 border-2 border-amber-500 rounded-full text-amber-500 transition-transform group-hover:scale-110 cursor-pointer\" data-kid=\"17\">\n          <i class=\"ti ti-microphone text-xl\" data-kid=\"18\"></i>\n        </div>\n      </div>\n    </div>\n  </header>\n\n  \n  <main class=\"flex-1 flex flex-col items-center justify-center px-16 text-center py-6\" data-kid=\"19\">\n    <div class=\"max-w-[1000px] mb-12 lg:mb-16\" data-kid=\"20\">\n      <h1 class=\"text-5xl md:text-6xl lg:text-[4.5rem] font-black leading-[1.05] tracking-tight text-balance\" data-kid=\"21\">\n        Finely chop the remaining <span class=\"text-emerald-400\" data-kid=\"22\">shallots</span> and <span class=\"text-emerald-400\" data-kid=\"23\">garlic cloves</span> into a consistent mince.\n      </h1>\n      \n      <p class=\"mt-6 text-zinc-400 text-lg font-medium max-w-2xl mx-auto leading-relaxed opacity-70\" data-kid=\"24\">\n        Aim for uniform pieces to ensure they cook evenly and release maximum aromatics in the pan.\n      </p>\n    </div>\n\n    \n    <div class=\"w-full max-w-3xl aspect-[21/9] rounded-2xl overflow-hidden border border-zinc-800 shadow-[0_20px_40px_-10px_rgba(0,0,0,0.6)] relative group\" data-kid=\"25\">\n      <video src=\"https://videos.pexels.com/video-files/8626098/8626098-uhd_2560_1440_25fps.mp4\" poster=\"https://images.pexels.com/videos/8626098/pexels-photo-8626098.jpeg?auto=compress&cs=tinysrgb&fit=crop&h=630&w=1200\" autoplay muted loop playsinline preload=\"metadata\" class=\"w-full h-full object-cover grayscale-[0.3] brightness-[0.7] group-hover:grayscale-0 group-hover:brightness-95 transition-all duration-700\" data-kid=\"26\"></video>\n      <div class=\"absolute inset-0 bg-gradient-to-t from-zinc-900/40 via-transparent to-transparent\" data-kid=\"27\"></div>\n      \n      \n      <div class=\"absolute bottom-4 left-6 flex items-center gap-2\" data-kid=\"28\">\n        <div class=\"w-6 h-6 rounded-full bg-emerald-500/20 flex items-center justify-center text-emerald-400 backdrop-blur-md\" data-kid=\"29\">\n          <i class=\"ti ti-eye text-xs\" data-kid=\"30\"></i>\n        </div>\n        <span class=\"text-white/60 text-[10px] font-black uppercase tracking-widest\" data-kid=\"31\">Visual Aid</span>\n      </div>\n    </div>\n  </main>\n\n  \n  <nav class=\"h-32 flex w-full border-t border-zinc-800\" data-kid=\"32\">\n    \n    <button class=\"flex-1 bg-zinc-800/50 hover:bg-zinc-800 active:bg-zinc-700 transition-all flex flex-col items-center justify-center gap-1 border-r border-zinc-900/50 group cursor-pointer\" data-kid=\"33\">\n      <div class=\"flex items-center gap-2 text-zinc-500 group-hover:text-zinc-100 transition-colors\" data-kid=\"34\">\n        <i class=\"ti ti-chevron-left text-3xl transition-transform group-hover:-translate-x-2\" data-kid=\"35\"></i>\n        <span class=\"text-sm font-black uppercase tracking-[0.2em]\" data-kid=\"36\">Previous</span>\n      </div>\n      <span class=\"text-[9px] text-zinc-600 font-bold uppercase tracking-widest opacity-0 group-hover:opacity-100 transition-opacity\" data-kid=\"37\">Back to Prep</span>\n    </button>\n    \n    \n    <button class=\"flex-[2] bg-emerald-800 hover:bg-emerald-700 active:bg-emerald-600 transition-all flex flex-col items-center justify-center gap-1 group relative overflow-hidden cursor-pointer\" data-kid=\"38\">\n      \n      <div class=\"absolute inset-0 bg-gradient-to-r from-transparent via-white/5 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-1000 ease-in-out\" data-kid=\"39\"></div>\n      \n      <div class=\"flex items-center gap-6 text-white\" data-kid=\"40\">\n        <span class=\"text-2xl font-black uppercase tracking-[0.4em]\" data-kid=\"41\">Next Step</span>\n        <i class=\"ti ti-chevron-right text-5xl transition-transform group-hover:translate-x-3\" data-kid=\"42\"></i>\n      </div>\n      <div class=\"flex items-center gap-2\" data-kid=\"43\">\n        <span class=\"w-1 h-1 rounded-full bg-emerald-400/50\" data-kid=\"44\"></span>\n        <span class=\"text-[10px] text-emerald-300/80 font-bold uppercase tracking-widest\" data-kid=\"45\">Sautéing Aromatics</span>\n        <span class=\"w-1 h-1 rounded-full bg-emerald-400/50\" data-kid=\"46\"></span>\n      </div>\n    </button>\n  </nav>\n\n  \n  <div class=\"absolute top-1/2 left-8 -translate-y-1/2 flex flex-col gap-8 opacity-20 hover:opacity-100 transition-opacity duration-500 hidden xl:flex\" data-kid=\"47\">\n    <div class=\"flex flex-col items-center gap-2\" data-kid=\"48\">\n      <i class=\"ti ti-clock text-2xl\" data-kid=\"49\"></i>\n      <span class=\"[writing-mode:vertical-lr] uppercase tracking-widest text-xs font-bold\" data-kid=\"50\">45 min left</span>\n    </div>\n    <div class=\"w-px h-12 bg-zinc-700 mx-auto\" data-kid=\"51\"></div>\n    <div class=\"flex flex-col items-center gap-2\" data-kid=\"52\">\n      <i class=\"ti ti-flame text-2xl\" data-kid=\"53\"></i>\n      <span class=\"[writing-mode:vertical-lr] uppercase tracking-widest text-xs font-bold\" data-kid=\"54\">320 kcal</span>\n    </div>\n  </div>\n</div>\n",
