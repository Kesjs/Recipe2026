      "html": "\n<body class=\"bg-zinc-50 font-sans text-zinc-900 selection:bg-emerald-100 selection:text-emerald-900\">\n  <style data-kid=\"0\">\n    @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Inter:wght@300;400;500;600;700&display=swap');\n    @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n    .font-serif { font-family: 'Playfair Display', serif; }\n    .font-sans { font-family: 'Inter', sans-serif; }\n\n    .paper-texture {\n      background-image: url(\"data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3ExternalIcon %3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E\");\n      opacity: 0.03;\n    }\n\n    .glass {\n      backdrop-filter: blur(24px);\n      background: rgba(255, 255, 255, 0.65);\n      border: 1px solid rgba(255, 255, 255, 0.4);\n    }\n\n    .translate-hover:hover i {\n      transform: translateX(6px);\n    }\n  </style>\n\n  \n  <div class=\"fixed inset-0 pointer-events-none paper-texture z-0\" data-kid=\"1\"></div>\n\n  \n  <nav class=\"relative z-10 flex items-center justify-between px-12 py-8 bg-transparent\" data-kid=\"2\">\n    <div class=\"flex items-center gap-12\" data-kid=\"3\">\n      <a href=\"/\" class=\"text-3xl font-serif font-bold tracking-tight text-emerald-950\" data-kid=\"4\">Naya.</a>\n      <div class=\"hidden md:flex items-center gap-8 text-sm font-semibold uppercase tracking-widest text-zinc-500\" data-kid=\"5\">\n        <a href=\"#\" class=\"hover:text-emerald-700 transition-colors\" data-kid=\"6\">Catalogue</a>\n        <a href=\"#\" class=\"hover:text-emerald-700 transition-colors\" data-kid=\"7\">Nutrition</a>\n        <a href=\"#\" class=\"text-emerald-700 border-b-2 border-emerald-700 pb-1\" data-kid=\"8\">Actualités</a>\n        <a href=\"#\" class=\"hover:text-emerald-700 transition-colors\" data-kid=\"9\">À Propos</a>\n      </div>\n    </div>\n    <div class=\"flex items-center gap-6\" data-kid=\"10\">\n      <button class=\"p-2 text-zinc-400 hover:text-emerald-700 transition-colors\" data-kid=\"11\">\n        <i class=\"ti ti-search text-2xl\" data-kid=\"12\"></i>\n      </button>\n      <button class=\"bg-zinc-900 text-white px-6 py-2.5 rounded-full text-sm font-bold uppercase tracking-widest hover:bg-emerald-700 transition-all duration-300\" data-kid=\"13\">\n        Se Connecter\n      </button>\n    </div>\n  </nav>\n\n  <main class=\"relative z-10\" data-kid=\"14\">\n    \n    <section class=\"px-8 mb-24\" data-kid=\"15\">\n      <div class=\"relative w-full h-[780px] rounded-[3.5rem] overflow-hidden group\" data-kid=\"16\">\n        <img src=\"https://images.unsplash.com/photo-1609342332922-c1d9ace16697?auto=format&w=1600&q=80&fit=crop\" alt=\"Featured Article\" class=\"w-full h-full object-cover transition-transform duration-1000 group-hover:scale-105\" decoding=\"async\" loading=\"lazy\" data-kid=\"17\">\n        \n        <div class=\"absolute inset-0 bg-linear-to-t from-zinc-900/40 to-transparent\" data-kid=\"18\"></div>\n\n        \n        <div class=\"absolute bottom-16 left-16 max-w-2xl glass p-14 rounded-[3rem] shadow-2xl translate-y-4 group-hover:translate-y-0 transition-transform duration-700\" data-kid=\"19\">\n          <div class=\"flex items-center gap-4 mb-8\" data-kid=\"20\">\n            <span class=\"px-4 py-1.5 bg-emerald-600 text-white text-[10px] font-bold tracking-[0.3em] uppercase rounded-full shadow-lg shadow-emerald-600/20\" data-kid=\"21\">Recette Vedette</span>\n            <span class=\"text-zinc-500 text-xs font-semibold uppercase tracking-widest\" data-kid=\"22\">8 min de lecture</span>\n          </div>\n          <h1 class=\"text-[5.5rem] font-serif text-zinc-900 leading-[0.95] mb-8 tracking-tighter\" data-kid=\"23\">Focus Nutrition: L'Amiwo au poulet</h1>\n          <p class=\"text-xl text-zinc-700 font-medium leading-relaxed mb-10\" data-kid=\"24\">\n            Découvrez comment équilibrer l'énergie de la farine de maïs avec les bienfaits nutritionnels essentiels de la grillade traditionnelle béninoise.\n          </p>\n          <button class=\"group/btn inline-flex items-center gap-4 bg-emerald-600 text-white px-10 py-5 rounded-full font-bold uppercase tracking-widest text-sm hover:bg-zinc-900 transition-all duration-300 shadow-xl shadow-emerald-600/30\" data-kid=\"25\">\n            Lire l'article\n            <i class=\"ti ti-arrow-right text-xl transition-transform duration-300 group-hover/btn:translate-x-2\" data-kid=\"26\"></i>\n          </button>\n        </div>\n      </div>\n    </section>\n\n    \n    <section class=\"max-w-7xl mx-auto px-8 mb-32\" data-kid=\"27\">\n      <div class=\"flex flex-col md:flex-row gap-20\" data-kid=\"28\">\n        \n        <div class=\"md:w-[60%] group\" data-kid=\"29\">\n          <div class=\"relative aspect-[16/10] rounded-[3rem] overflow-hidden mb-10 shadow-lg group-hover:shadow-2xl transition-all duration-500\" data-kid=\"30\">\n            <img src=\"https://images.pexels.com/photos/13887558/pexels-photo-13887558.jpeg?auto=compress&cs=tinysrgb&w=1200&q=80\" alt=\"Garba\" class=\"w-full h-full object-cover transition-transform duration-700 group-hover:scale-105\" decoding=\"async\" loading=\"lazy\" data-kid=\"31\">\n            <div class=\"absolute top-8 left-8 glass px-5 py-2 rounded-full\" data-kid=\"32\">\n              <span class=\"text-[10px] font-bold tracking-widest text-emerald-900 uppercase\" data-kid=\"33\">Art Culinaire</span>\n            </div>\n          </div>\n          <h2 class=\"text-5xl font-serif leading-tight text-zinc-900 mb-6 group-hover:text-emerald-700 transition-colors duration-300\" data-kid=\"34\">\n            L'art d'équilibrer son Garba : Maîtriser l'Attiéké\n          </h2>\n          <div class=\"flex items-center gap-4 mb-6 text-zinc-400 text-xs font-bold uppercase tracking-widest\" data-kid=\"35\">\n            <span data-kid=\"36\">Par Marie-Claire K.</span>\n            <span class=\"w-1 h-1 bg-zinc-300 rounded-full\" data-kid=\"37\"></span>\n            <span data-kid=\"38\">12 Octobre 2024</span>\n          </div>\n          <p class=\"text-lg text-zinc-500 leading-relaxed mb-10 max-w-2xl\" data-kid=\"39\">\n            Le Garba est bien plus qu'un simple repas. Apprenez à gérer les portions et à optimiser la qualité des huiles pour transformer ce délice ivoirien en un allié santé.\n          </p>\n          <button class=\"inline-flex items-center gap-4 bg-emerald-600 text-white px-8 py-4 rounded-full font-bold uppercase tracking-widest text-xs translate-hover transition-all duration-300 hover:bg-zinc-900 hover:shadow-xl hover:shadow-emerald-600/20\" data-kid=\"40\">\n            Lire la suite\n            <i class=\"ti ti-arrow-right text-lg transition-transform duration-300\" data-kid=\"41\"></i>\n          </button>\n        </div>\n\n        \n        <div class=\"md:w-[40%] flex flex-col justify-center group\" data-kid=\"42\">\n          <div class=\"relative aspect-square rounded-[3rem] overflow-hidden mb-10 shadow-lg group-hover:shadow-2xl transition-all duration-500\" data-kid=\"43\">\n            <img src=\"https://images.unsplash.com/photo-1512621776951-a57141f2eefd?auto=format&w=800&q=80&fit=crop\" alt=\"Gombo\" class=\"w-full h-full object-cover transition-transform duration-700 group-hover:scale-105\" decoding=\"async\" loading=\"lazy\" data-kid=\"44\">\n            <div class=\"absolute top-8 left-8 glass px-5 py-2 rounded-full\" data-kid=\"45\">\n              <span class=\"text-[10px] font-bold tracking-widest text-emerald-900 uppercase\" data-kid=\"46\">Bien-être</span>\n            </div>\n          </div>\n          <h2 class=\"text-4xl font-serif leading-tight text-zinc-900 mb-6 group-hover:text-emerald-700 transition-colors duration-300\" data-kid=\"47\">\n            Super-aliments : Le Gombo et le Moringa\n          </h2>\n          <div class=\"flex items-center gap-4 mb-6 text-zinc-400 text-xs font-bold uppercase tracking-widest\" data-kid=\"48\">\n            <span data-kid=\"49\">Dr. Jean-Baptiste</span>\n            <span class=\"w-1 h-1 bg-zinc-300 rounded-full\" data-kid=\"50\"></span>\n            <span data-kid=\"51\">08 Octobre 2024</span>\n          </div>\n          <p class=\"text-zinc-500 leading-relaxed mb-10 line-clamp-3\" data-kid=\"52\">\n            Exploration des fibres solubles et des antioxydants puissants de nos terroirs. Comment ces trésors boostent votre immunité quotidienne.\n          </p>\n          <button class=\"inline-flex items-center gap-4 bg-emerald-600 text-white px-8 py-4 rounded-full font-bold uppercase tracking-widest text-xs translate-hover transition-all duration-300 hover:bg-zinc-900 hover:shadow-xl hover:shadow-emerald-600/20\" data-kid=\"53\">\n            Lire la suite\n            <i class=\"ti ti-arrow-right text-lg transition-transform duration-300\" data-kid=\"54\"></i>\n          </button>\n        </div>\n      </div>\n    </section>\n\n    \n    <section class=\"max-w-7xl mx-auto px-8 mb-32\" data-kid=\"55\">\n      <div class=\"flex items-center justify-between mb-16\" data-kid=\"56\">\n        <h3 class=\"text-3xl font-serif text-zinc-900\" data-kid=\"57\">À Découvrir Également</h3>\n        <div class=\"h-px grow mx-12 bg-zinc-200\" data-kid=\"58\"></div>\n        <button class=\"text-xs font-bold uppercase tracking-[0.3em] text-zinc-400 hover:text-emerald-700 transition-colors\" data-kid=\"59\">Voir Tout</button>\n      </div>\n\n      <div class=\"grid grid-cols-1 md:grid-cols-3 gap-12\" data-kid=\"60\">\n        \n        <div class=\"group bg-white p-10 rounded-[3rem] border border-zinc-100 shadow-sm hover:shadow-2xl transition-all duration-500\" data-kid=\"61\">\n          <div class=\"flex items-center justify-between mb-8\" data-kid=\"62\">\n            <div class=\"w-14 h-14 bg-red-50 text-red-600 rounded-2xl flex items-center justify-center shadow-sm\" data-kid=\"63\">\n              <i class=\"ti ti-droplets text-2xl\" data-kid=\"64\"></i>\n            </div>\n            <span class=\"text-[10px] font-bold tracking-widest text-zinc-400 uppercase\" data-kid=\"65\">Astuce</span>\n          </div>\n          <h4 class=\"text-2xl font-serif text-zinc-900 mb-6 group-hover:text-emerald-700 transition-colors\" data-kid=\"66\">Hydratation et Climat Chaud</h4>\n          <p class=\"text-zinc-500 leading-relaxed mb-10 line-clamp-3\" data-kid=\"67\">\n            Oubliez les sodas. Découvrez pourquoi le Bissap sans sucre et les infusions de citronnelle sont vos meilleurs alliés rafraîchissants.\n          </p>\n          <button class=\"inline-flex items-center gap-3 bg-emerald-600 text-white px-6 py-3.5 rounded-full font-bold uppercase tracking-widest text-[10px] translate-hover transition-all duration-300 hover:bg-zinc-900\" data-kid=\"68\">\n            Lire la suite\n            <i class=\"ti ti-arrow-right text-sm transition-transform duration-300\" data-kid=\"69\"></i>\n          </button>\n        </div>\n\n        \n        <div class=\"group bg-white p-10 rounded-[3rem] border border-zinc-100 shadow-sm hover:shadow-2xl transition-all duration-500\" data-kid=\"70\">\n          <div class=\"flex items-center justify-between mb-8\" data-kid=\"71\">\n            <div class=\"w-14 h-14 bg-blue-50 text-blue-600 rounded-2xl flex items-center justify-center shadow-sm\" data-kid=\"72\">\n              <i class=\"ti ti-utensils text-2xl\" data-kid=\"73\"></i>\n            </div>\n            <span class=\"text-[10px] font-bold tracking-widest text-zinc-400 uppercase\" data-kid=\"74\">Recette</span>\n          </div>\n          <h4 class=\"text-2xl font-serif text-zinc-900 mb-6 group-hover:text-emerald-700 transition-colors\" data-kid=\"75\">Les Bienfaits du Thiéboudienne</h4>\n          <p class=\"text-zinc-500 leading-relaxed mb-10 line-clamp-3\" data-kid=\"76\">\n            Un équilibre magistral entre protéines de poisson et fibres de légumes frais. Le secret du plat national sénégalais.\n          </p>\n          <button class=\"inline-flex items-center gap-3 bg-emerald-600 text-white px-6 py-3.5 rounded-full font-bold uppercase tracking-widest text-[10px] translate-hover transition-all duration-300 hover:bg-zinc-900\" data-kid=\"77\">\n            Lire la suite\n            <i class=\"ti ti-arrow-right text-sm transition-transform duration-300\" data-kid=\"78\"></i>\n          </button>\n        </div>\n\n        \n        <div class=\"group bg-white p-10 rounded-[3rem] border border-zinc-100 shadow-sm hover:shadow-2xl transition-all duration-500\" data-kid=\"79\">\n          <div class=\"flex items-center justify-between mb-8\" data-kid=\"80\">\n            <div class=\"w-14 h-14 bg-yellow-50 text-yellow-600 rounded-2xl flex items-center justify-center shadow-sm\" data-kid=\"81\">\n              <i class=\"ti ti-carrot text-2xl\" data-kid=\"82\"></i>\n            </div>\n            <span class=\"text-[10px] font-bold tracking-widest text-zinc-400 uppercase\" data-kid=\"83\">Recette</span>\n          </div>\n          <h4 class=\"text-2xl font-serif text-zinc-900 mb-6 group-hover:text-emerald-700 transition-colors\" data-kid=\"84\">Aloco : Modération et Plaisir</h4>\n          <p class=\"text-zinc-500 leading-relaxed mb-10 line-clamp-3\" data-kid=\"85\">\n            Les bananes plantains frites revisitées. Comment profiter de ce classique sans excès calorique.\n          </p>\n          <button class=\"inline-flex items-center gap-3 bg-emerald-600 text-white px-6 py-3.5 rounded-full font-bold uppercase tracking-widest text-[10px] translate-hover transition-all duration-300 hover:bg-zinc-900\" data-kid=\"86\">\n            Lire la suite\n            <i class=\"ti ti-arrow-right text-sm transition-transform duration-300\" data-kid=\"87\"></i>\n          </button>\n        </div>\n      </div>\n    </section>\n\n    \n    <section class=\"max-w-7xl mx-auto px-8 mb-24\" data-kid=\"88\">\n      <div class=\"relative bg-zinc-900 rounded-[4rem] p-24 overflow-hidden text-center\" data-kid=\"89\">\n        \n        <div class=\"absolute top-0 left-0 w-64 h-64 bg-emerald-500/10 blur-[100px] rounded-full -translate-x-1/2 -translate-y-1/2\" data-kid=\"90\"></div>\n        <div class=\"absolute bottom-0 right-0 w-96 h-96 bg-emerald-500/10 blur-[120px] rounded-full translate-x-1/2 translate-y-1/2\" data-kid=\"91\"></div>\n        \n        <div class=\"relative z-10\" data-kid=\"92\">\n          <h2 class=\"text-5xl font-serif text-white mb-8\" data-kid=\"93\">Ne manquez aucun conseil nutritionnel.</h2>\n          <p class=\"text-zinc-400 text-lg mb-12 max-w-2xl mx-auto\" data-kid=\"94\">Rejoignez notre newsletter pour recevoir chaque semaine une dose d'inspiration culinaire et de bien-être.</p>\n          <div class=\"flex flex-col sm:flex-row items-center justify-center gap-4\" data-kid=\"95\">\n            <input type=\"email\" placeholder=\"votre@email.com\" class=\"w-full sm:w-80 px-8 py-5 rounded-full bg-zinc-800 border border-zinc-700 text-white placeholder-zinc-500 focus:outline-none focus:ring-2 focus:ring-emerald-500/50 transition-all\" data-kid=\"96\">\n            <button class=\"w-full sm:w-auto px-10 py-5 bg-emerald-600 text-white rounded-full font-bold uppercase tracking-widest text-sm hover:bg-emerald-500 transition-all duration-300\" data-kid=\"97\">S'inscrire</button>\n          </div>\n        </div>\n      </div>\n    </section>\n  </main>\n\n  \n  <footer class=\"bg-white border-t border-zinc-100 px-12 py-20 relative z-10\" data-kid=\"98\">\n    <div class=\"max-w-7xl mx-auto\" data-kid=\"99\">\n      <div class=\"grid grid-cols-1 md:grid-cols-4 gap-16 mb-20\" data-kid=\"100\">\n        <div class=\"col-span-1\" data-kid=\"101\">\n          <a href=\"/\" class=\"text-4xl font-serif font-bold tracking-tight text-emerald-950 block mb-8\" data-kid=\"102\">Naya.</a>\n          <p class=\"text-zinc-500 leading-relaxed mb-8\" data-kid=\"103\">Redécouvrez les saveurs de chez vous, optimisées pour votre santé.</p>\n          <div class=\"flex items-center gap-4\" data-kid=\"104\">\n            <a href=\"#\" class=\"w-10 h-10 rounded-full border border-zinc-200 flex items-center justify-center text-zinc-400 hover:text-emerald-600 hover:border-emerald-600 transition-all\" data-kid=\"105\"><i class=\"ti ti-brand-instagram\" data-kid=\"106\"></i></a>\n            <a href=\"#\" class=\"w-10 h-10 rounded-full border border-zinc-200 flex items-center justify-center text-zinc-400 hover:text-emerald-600 hover:border-emerald-600 transition-all\" data-kid=\"107\"><i class=\"ti ti-brand-facebook\" data-kid=\"108\"></i></a>\n            <a href=\"#\" class=\"w-10 h-10 rounded-full border border-zinc-200 flex items-center justify-center text-zinc-400 hover:text-emerald-600 hover:border-emerald-600 transition-all\" data-kid=\"109\"><i class=\"ti ti-brand-twitter\" data-kid=\"110\"></i></a>\n          </div>\n        </div>\n        <div data-kid=\"111\">\n          <h5 class=\"font-bold uppercase tracking-widest text-xs mb-8 text-zinc-900\" data-kid=\"112\">Explorer</h5>\n          <ul class=\"space-y-4 text-zinc-500 font-medium\" data-kid=\"113\">\n            <li data-kid=\"114\"><a href=\"#\" class=\"hover:text-emerald-600 transition-colors\" data-kid=\"115\">Catalogue Recettes</a></li>\n            <li data-kid=\"116\"><a href=\"#\" class=\"hover:text-emerald-600 transition-colors\" data-kid=\"117\">Nutrition & Santé</a></li>\n            <li data-kid=\"118\"><a href=\"#\" class=\"hover:text-emerald-600 transition-colors\" data-kid=\"119\">Actualités</a></li>\n            <li data-kid=\"120\"><a href=\"#\" class=\"hover:text-emerald-600 transition-colors\" data-kid=\"121\">Communauté</a></li>\n          </ul>\n        </div>\n        <div data-kid=\"122\">\n          <h5 class=\"font-bold uppercase tracking-widest text-xs mb-8 text-zinc-900\" data-kid=\"123\">Support</h5>\n          <ul class=\"space-y-4 text-zinc-500 font-medium\" data-kid=\"124\">\n            <li data-kid=\"125\"><a href=\"#\" class=\"hover:text-emerald-600 transition-colors\" data-kid=\"126\">FAQ</a></li>\n            <li data-kid=\"127\"><a href=\"#\" class=\"hover:text-emerald-600 transition-colors\" data-kid=\"128\">Contact</a></li>\n            <li data-kid=\"129\"><a href=\"#\" class=\"hover:text-emerald-600 transition-colors\" data-kid=\"130\">Aide</a></li>\n          </ul>\n        </div>\n        <div data-kid=\"131\">\n          <h5 class=\"font-bold uppercase tracking-widest text-xs mb-8 text-zinc-900\" data-kid=\"132\">Légal</h5>\n          <ul class=\"space-y-4 text-zinc-500 font-medium\" data-kid=\"133\">\n            <li data-kid=\"134\"><a href=\"#\" class=\"hover:text-emerald-600 transition-colors\" data-kid=\"135\">Confidentialité</a></li>\n            <li data-kid=\"136\"><a href=\"#\" class=\"hover:text-emerald-600 transition-colors\" data-kid=\"137\">CGU</a></li>\n            <li data-kid=\"138\"><a href=\"#\" class=\"hover:text-emerald-600 transition-colors\" data-kid=\"139\">Cookies</a></li>\n          </ul>\n        </div>\n      </div>\n      <div class=\"flex flex-col md:flex-row items-center justify-between pt-12 border-t border-zinc-100 text-zinc-400 text-sm font-medium\" data-kid=\"140\">\n        <p data-kid=\"141\">© 2024 Naya App. Tous droits réservés.</p>\n        <div class=\"flex items-center gap-8 mt-4 md:mt-0\" data-kid=\"142\">\n          <span data-kid=\"143\">Fait avec passion pour une Afrique plus saine.</span>\n        </div>\n      </div>\n    </div>\n  </footer>\n</body>\n",
